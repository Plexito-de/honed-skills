    // A note made on a longer render gets no picture: the last frame is not its moment.
    api.marks.push({ id: 805, item: "d1", tool: "note", note: "longer cut", t: 9.5 });
    const late = (await api.buildBatch()).pages.find(p => p.item === "d1");
    say("a moment past the end of this render has no frame",
        late ? [late.frames.some(f => f.key === "9.500"), late.comments.some(c => c.id === "m_805")] : null,
        [false, true]);

    // A mark from a picture, restored onto the video (ids are positions): an orphan, never a hang.
    api.marks.push({ id: 806, item: "d1", tool: "ellipse", note: "from a picture",
                     x0: 0.1, y0: 0.1, x1: 0.3, y1: 0.3, path: [] });
    let orphanBatch = null;
    try { orphanBatch = await Promise.race([api.buildBatch(), sleep(15000).then(() => null)]); }
    catch (e) { orphanBatch = String(e); }
    say("a mark without a moment on a video does not stop Send",
        !!orphanBatch && typeof orphanBatch === "object", true);
    say("and travels with the overall note",
        orphanBatch && typeof orphanBatch === "object" ? orphanBatch.note.includes("from a picture") : null, true);
    say("and is not also sent as a note at 0:00 of the video",
        orphanBatch && typeof orphanBatch === "object"
          ? (orphanBatch.pages.find(p => p.item === "d1")?.comments || []).some(c => c.id === "m_806")
          : null, false);
    api.marks.length = 0;

    await until(() => broken.sayEl.textContent.length > 0, 8000);
    say("a file the browser cannot play says so", broken.sayEl.textContent.includes("cannot play"), true);
    api.marks.push({ id: 804, item: "d3", tool: "note", note: "still mine", t: 0 });
