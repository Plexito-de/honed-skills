    say("the pen stops the video", v.paused, true);
    say("the mark belongs to the frame on screen",
        !!drawn && drawn.tool === "ellipse" && Math.abs(drawn.t - v.currentTime) < 1e-6, true);
    say("that moment is the middle of a frame",
        !!drawn && Math.abs(((drawn.t * 10) % 1) - 0.5) < 1e-3, true);
    await until(() => !v.seeking); await sleep(80);
    const ink = () => { if (!cv.width) return 0;
      const d = cv.getContext("2d").getImageData(0, 0, cv.width, cv.height).data;
      let n = 0; for (let i = 3; i < d.length; i += 4) if (d[i]) n++; return n; };
    say("the mark is drawn at its moment", ink() > 50, true);

    const key = (k, target) => (target || s.player).dispatchEvent(
      new KeyboardEvent("keydown", { key: k, bubbles: true, cancelable: true }));
    const settled = async () => { await until(() => !v.seeking); await sleep(80); };
    const t0 = v.currentTime;
    key("."); await settled();
    say("a period steps one frame on", Math.round((v.currentTime - t0) * 1000), 100);
    say("and the mark is not shown off its frame", ink(), 0);
    key(","); await settled();
    say("a comma steps back onto it", ink() > 50, true);

    const n1 = api.marks.length;
    key("i");
    for (let i = 0; i < 5; i++) key(".");
    key("o");
    const span = api.marks[api.marks.length - 1];
    say("i, then o five frames on, makes a span of half a second",
        span && span.tool === "span" ? Math.round((span.t_end - span.t) * 1000) : null, 500);
    key("n");
    const note = api.marks[api.marks.length - 1];
    say("n makes a note at the playhead",
        !!note && note.tool === "note" && Math.abs(note.t - v.currentTime) < 1e-6, true);
    say("each key made one mark", api.marks.length - n1, 2);

    const navState = () => document.body.className + "|" + document.getElementById("nav").className
      + "|" + document.getElementById("nav").style.display;
