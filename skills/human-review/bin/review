    say("a shape carries its box and its crop, a note neither",
        [!!byId.m_802?.crop, !!byId.m_802?.box, "crop" in (byId.m_801 || {})], [true, true, false]);
    say("a span names the frame at each end", [byId.m_803?.frame, byId.m_803?.frame_end],
