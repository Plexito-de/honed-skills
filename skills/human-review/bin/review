    document.body.dispatchEvent(new KeyboardEvent("keydown", { key: ".", bubbles: true }));
    await sleep(150);
    say("a period outside the player does not move the video", v.currentTime, t1);
    s.playBtn.focus();
    key(" ", s.playBtn);
    await sleep(100);
    say("Space on the Play button is left to the button", v.paused, true);

    // What Send makes of it: one frame per moment, and each frame is that moment.
    api.marks.length = 0;
    api.marks.push(
      { id: 801, item: "d1", tool: "note", note: "red part", t: 0.55 },
