      return d[0] > 150 && d[2] < 100 ? "red" : d[2] > 150 && d[0] < 100 ? "blue" : `${d[0]},${d[1]},${d[2]}`; };
    const frameAt = k => (vp?.frames.find(f => f.key === k) || {}).image;
