    say("a note on it is still sent, without a frame", bp ? [bp.comments.length, bp.frames.length] : null, [1, 0]);
    api.marks.length = 0;

    if (mode === "narrow") {
      say("no horizontal overflow at this width",
          document.documentElement.scrollWidth <= window.innerWidth, true);
      const small = [...s.player.querySelectorAll("button, select")]
        .filter(b => b.offsetParent !== null)
        .filter(b => b.getBoundingClientRect().height < 24 || b.getBoundingClientRect().width < 24);
      say("every control of the player is at least 24 px", small.map(b => b.className), []);
    }
  } catch (e) {
    out.push(["the browser test itself ran to the end", String(e && e.stack || e), true]);
  }
  fetch("/draft", { method: "POST", headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ __test__: out }) });
};
"""


def browser_selftest(check) -> None:
    chrome = find_chrome()
    if not chrome:
        print("skip: the browser cases need Chrome or Chromium, and neither is installed")
        return
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        sess = tmp / "sess"
        sess.mkdir()
        pdf = tmp / "statement.pdf"
        make_fixture_pdf(pdf, FIXTURE_PAGES)
        draft = tmp / "draft.md"
        draft.write_text(FIXTURE_DRAFT)
        items = stage_inputs([pdf, draft], sess)
        run_in_chrome(chrome, sess, items, TEST_JS, tmp, check)


def run_in_chrome(chrome: str, sess: Path, items: list, test_js: str, tmp: Path, check,
                  draft: dict | None = None, label: str = "") -> None:
    """Serve the session with `test_js`, open it in headless Chrome at desktop and at phone
    width, and turn what the page reports into checks. `draft` is put in place before each
    width, so a case can test what comes back from a saved draft."""
    with serving(sess, items, test_js=test_js) as base:
        for mode, size in (("wide", "1440,900"), ("narrow", "390,844")):
            (sess / "draft.json").unlink(missing_ok=True)
            if draft is not None:
                (sess / "draft.json").write_text(json.dumps(draft))
            # No --dump-dom and no virtual time: this Chrome prints its DOM and then hangs on
            # shutdown (measured 2026-10-02, Chrome 141), and virtual time freezes the page
            # before pdf.js has drawn anything. The page reports its own results instead, and
            # the browser is killed as soon as they arrive.
            proc = subprocess.Popen(
                [chrome, "--headless=new", "--disable-gpu", "--no-first-run",
                 "--no-default-browser-check", "--disable-extensions",
                 "--disable-background-networking", "--disable-component-update",
                 "--disable-sync", "--autoplay-policy=no-user-gesture-required",
                 f"--user-data-dir={tmp}/profile-{label}{mode}",
                 f"--window-size={size}", "--force-device-scale-factor=2",
                 f"{base}?mode={mode}"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            results = None
            deadline = time.time() + 90
            while time.time() < deadline and results is None:
                f = sess / "draft.json"
                if f.exists():
                    try:
                        results = json.loads(f.read_text()).get("__test__")
                    except ValueError:
                        results = None
                time.sleep(0.05)
            proc.terminate()
            if results is None:
                check(f"the browser reported its results ({label}{mode})", "no results", "results")
                continue
            for name, got, want in results:
                check(f"{name} [{mode}]", got, want)


def video_fixture(folder: Path) -> Path | None:
    """Two seconds, one red and one blue, 9:16 at 10 frames a second, so a frame read back from
    the page says by its colour which second it came from. VP9 first, because a Chromium build
    without the H.264 decoder still plays it."""
    if not shutil.which("ffmpeg"):
        return None
    src = ["-f", "lavfi", "-i", "color=c=red:s=180x320:r=10:d=1",
           "-f", "lavfi", "-i", "color=c=blue:s=180x320:r=10:d=1",
           "-filter_complex", "[0][1]concat=n=2:v=1:a=0"]
    for name, codec in (("clip.webm", ["-c:v", "libvpx-vp9", "-b:v", "200k"]),
                        ("clip.mp4", ["-c:v", "libx264", "-pix_fmt", "yuv420p"])):
        out = folder / name
        made = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", *src,
                               *codec, str(out)], capture_output=True, timeout=120)
        if made.returncode == 0 and out.exists():
            return out
    return None


def browser_video_selftest(check) -> None:
    chrome = find_chrome()
    if not chrome:
        return                              # browser_selftest has said so already
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        clip = video_fixture(tmp)
        if not clip:
            print("skip: the video cases in the browser need ffmpeg with libvpx-vp9 or libx264")
            return
        sess = tmp / "sess"
        sess.mkdir()
        draft = tmp / "draft.md"
        draft.write_text(FIXTURE_DRAFT)
        broken = tmp / "broken.mp4"         # what a browser gets when nothing could convert it
        broken.write_bytes(os.urandom(4096))
        with contextlib.redirect_stderr(io.StringIO()):
            items = stage_inputs([clip, draft], sess)
            orig_which = shutil.which
            shutil.which = lambda cmd: None if cmd in ("ffprobe", "ffmpeg") else orig_which(cmd)
            try:
                tail = stage_inputs([broken], tmp / "sess-broken")[0]
            finally:
                shutil.which = orig_which
        # Staged in a second session, so it carries the next id here, and its file is moved in.
        tail = dict(tail, id="d3", asset="d3_broken", url="/asset/d3_broken.mp4")
        shutil.copy2(tmp / "sess-broken" / "assets" / "d1_broken.mp4",
                     sess / "assets" / "d3_broken.mp4")
        items.append(tail)
        (sess / "items.json").write_text(json.dumps(items))
        saved = {"seq": 2, "overall": "", "comments": [], "marks": [
            {"id": 1, "item": "d1", "tool": "span", "note": "restored span", "t": 0.25,
             "t_end": 0.75},
            {"id": 2, "item": "d1", "tool": "rect", "note": "restored box", "t": 0.35,
             "x0": 0.1, "y0": 0.1, "x1": 0.4, "y1": 0.2, "path": []}]}
        run_in_chrome(chrome, sess, items, TEST_VIDEO_JS, tmp, check, draft=saved,
                      label="video-")


def main() -> int:
    ap = argparse.ArgumentParser(prog="review", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    o = sub.add_parser("open"); o.add_argument("files", nargs="+")
    o.add_argument("--no-browser", action="store_true")
    o.add_argument("--port", type=int, default=None, metavar="N",
                   help="listen on this port instead of any free one, still on 127.0.0.1 only. "
                        "Also settable as REVIEW_PORT.")
    o.add_argument("--on-send", default="", metavar="CMD",
                   help="command to run once a batch has been written, split like a shell line "
                        "but run without a shell (no pipe, no &&), for whatever tells "
                        "the agent it arrived")
    o.set_defaults(fn=cmd_open)
    p = sub.add_parser("poll"); p.add_argument("--session"); p.add_argument("--ack", action="store_true")
    p.add_argument("--timeout", type=float, default=0); p.set_defaults(fn=cmd_poll)
    s = sub.add_parser("status"); s.add_argument("--session"); s.set_defaults(fn=cmd_status)
    c = sub.add_parser("close"); c.add_argument("--session"); c.set_defaults(fn=cmd_close)
    t = sub.add_parser("selftest")
    t.add_argument("--browser", action="store_true",
                   help="also drive the page in headless Chrome: pdf.js rendering, the text "
                        "layer, the contents list, and the phone layout at 390x844")
    t.set_defaults(fn=cmd_selftest)
    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
