#!/usr/bin/env python3
"""review: one page where the reviewer marks up text AND media, and sends it all back at once.

WHY THIS EXISTS RATHER THAN A FORK
----------------------------------
Upstream human-review (MIT, Peter Yang) reviews text well and cannot annotate an image. Vendoring
it means owning 6747 lines of Node across 19 files, losing the `npx` update path, and still bolting
media on afterwards. Two small ideas from it are worth having, and they are ported here with
attribution rather than the whole runtime: prefix/quote/suffix anchoring for a selection, and
block-level before/after edit extraction.

What this adds that neither half had: a draft is rarely only prose or only a picture. An invitation
is a rendered card AND its copy. A post is text AND its hero image. Splitting the review across two
tools splits the reviewer's attention and costs a round every time.

DESIGN
------
- Python standard library only. No pip, no npm, no Node, works offline.
- The browser renders the marked-up overview and cuts one crop per mark, so this file needs no
  image library at all.
- A PDF is served as the PDF, and the browser draws its pages with the vendored copy of PDF.js in
  assets/vendor/pdfjs (Apache-2.0, pinned, checksummed, never fetched at run time). So a page is
  as sharp as the screen allows, its text can be selected, and this file renders nothing.
- Sessions live in ~/.claude/.review/<id>/ and hold everything the agent reads back.

USAGE
  review open draft.md card.png form.pdf     stage anything, open the page, return at once
  review open deck.pptx                      one page per slide, plus the speaker notes as text
  review open document.docx                  one page per page, rendered via LibreOffice
  review poll [--session ID] [--ack]         block until Send, print the batch as JSON
  review status [--session ID]               is a batch waiting
  review close [--session ID]                stop the server
"""
from __future__ import annotations

import argparse
import base64
import contextlib
import hashlib
import html as html_mod
import http.server
import io
import json
import os
import posixpath
import re
import secrets
import shlex
import shutil
import signal
import socket
import socketserver
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
import webbrowser
import xml.etree.ElementTree as ET
import zipfile
from pathlib import Path
from urllib.parse import unquote, urlsplit

ROOT = Path.home() / ".claude" / ".review"
ASSETS = Path(__file__).resolve().parent.parent / "assets"
APP = ASSETS / "review.html"
VENDOR = ASSETS / "vendor" / "pdfjs"
# Exactly what /vendor/ may serve. A name that is not in here is a 404, so no request can walk out
# of the folder and no file lands in the page that the checksum file does not cover.
VENDOR_FILES = ("pdf.min.mjs", "pdf.worker.min.mjs")
IMAGE_SUFFIXES = {".png", ".jpg", ".jpeg", ".gif", ".webp"}
TEXT_SUFFIXES = {".md", ".markdown", ".html", ".htm", ".txt"}
VIDEO_SUFFIXES = {".mp4", ".m4v", ".mov", ".webm"}
DRAFT_TOOLS = {"ellipse", "rect", "free", "arrow"}  # the shapes the page can draw on a draft
# On a video the same four shapes, plus a note at one moment and a note over a span of time.
VIDEO_TOOLS = DRAFT_TOOLS | {"note", "span"}
CONTENT_TYPES = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
                 ".gif": "image/gif", ".webp": "image/webp", ".pdf": "application/pdf",
                 ".mp4": "video/mp4", ".m4v": "video/mp4", ".mov": "video/quicktime",
                 ".webm": "video/webm",
                 ".mjs": "text/javascript; charset=utf-8", ".js": "text/javascript; charset=utf-8",
                 ".json": "application/json"}


# --------------------------------------------------------------------------- markdown
def render_markdown(src: str) -> str:
    """A deliberately small Markdown subset: headings, lists, quotes, code, tables, emphasis.

    Full CommonMark would mean a dependency. Everything he reviews here is a draft he wrote or
    that I wrote for him, so the subset that appears in those drafts is the subset that matters.
    Anything unrecognised survives as a paragraph rather than disappearing.
    """
    def inline(t: str) -> str:
        t = html_mod.escape(t)
        code_spans: list[str] = []
        def save_code(m):
            code_spans.append(f"<code>{m.group(1)}</code>")
            return f"\x00code{len(code_spans)-1}\x00"
        t = re.sub(r"`([^`]+)`", save_code, t)
        t = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", t)
        t = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"<em>\1</em>", t)
        t = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2">\1</a>', t)
        for idx, span in enumerate(code_spans):
            t = t.replace(f"\x00code{idx}\x00", span)
        return t

    def is_block_start(s: str) -> bool:
        if s.startswith(("#", "```")):
            return True
        if re.match(r"^\s*>", s):
            return True
        if s.lstrip().startswith("|"):
            return True
        if re.match(r"^\s*([-*_])\1{2,}\s*$", s):
            return True
        if re.match(r"^\s*[-*+]\s+", s) or re.match(r"^\s*\d+[.)]\s+", s):
            return True
        return False

    out: list[str] = []
    lines = src.splitlines()
    i, n = 0, len(lines)
    while i < n:
        line = lines[i]
        if not line.strip():
            i += 1
            continue
        if line.startswith("```"):                                   # fenced code
            i += 1
            buf = []
            while i < n and not lines[i].startswith("```"):
                buf.append(lines[i]); i += 1
            i += 1
            out.append("<pre><code>" + html_mod.escape("\n".join(buf)) + "</code></pre>")
            continue
        m = re.match(r"^(#{1,6})\s+(.*)$", line)
        if m:
            lvl = len(m.group(1))
            out.append(f"<h{lvl}>{inline(m.group(2))}</h{lvl}>"); i += 1
            continue
        if re.match(r"^\s*([-*_])\1{2,}\s*$", line):
            out.append("<hr>"); i += 1
            continue
        if line.lstrip().startswith("|") and i + 1 < n and re.match(r"^\s*\|[\s:|-]+\|\s*$", lines[i+1]):
            rows = []
            while i < n and lines[i].lstrip().startswith("|"):
                rows.append([c.strip() for c in lines[i].strip().strip("|").split("|")]); i += 1
            head, body = rows[0], rows[2:]
            cells = "".join(f"<th>{inline(c)}</th>" for c in head)
            trs = "".join("<tr>" + "".join(f"<td>{inline(c)}</td>" for c in r) + "</tr>" for r in body)
            out.append(f"<table><thead><tr>{cells}</tr></thead><tbody>{trs}</tbody></table>")
            continue
        if re.match(r"^\s*>", line):
            buf = []
            while i < n and re.match(r"^\s*>", lines[i]):
                buf.append(re.sub(r"^\s*>\s?", "", lines[i])); i += 1
            out.append("<blockquote>" + inline(" ".join(buf)) + "</blockquote>")
            continue
        if re.match(r"^\s*[-*+]\s+", line) or re.match(r"^\s*\d+[.)]\s+", line):
            ordered = bool(re.match(r"^\s*\d+[.)]\s+", line))
            items = []
            pat = r"^\s*\d+[.)]\s+" if ordered else r"^\s*[-*+]\s+"
            while i < n and re.match(pat, lines[i]):
                items.append(inline(re.sub(pat, "", lines[i]))); i += 1
            tag = "ol" if ordered else "ul"
            out.append(f"<{tag}>" + "".join(f"<li>{x}</li>" for x in items) + f"</{tag}>")
            continue
        buf = [line]; i += 1
        while i < n and lines[i].strip() and not is_block_start(lines[i]):
            buf.append(lines[i]); i += 1
        out.append("<p>" + inline(" ".join(buf)) + "</p>")
    return "\n".join(out)


def html_body(src: str) -> str:
    """Take the body of an HTML document, minus scripts, so the review page stays in control."""
    m = re.search(r"<body[^>]*>(.*)</body>", src, re.S | re.I)
    body = m.group(1) if m else src
    body = re.sub(r"<script\b.*?</script>", "", body, flags=re.S | re.I)
    return body


# --------------------------------------------------------------------------- session
def session_id(paths: list[Path]) -> str:
    key = "|".join(str(p.resolve()) for p in sorted(paths))
    return hashlib.sha1(key.encode()).hexdigest()[:12]


def latest_session() -> Path | None:
    if not ROOT.exists():
        return None
    live = [d for d in ROOT.iterdir() if d.is_dir() and (d / "items.json").exists()]
    return max(live, key=lambda d: d.stat().st_mtime) if live else None


def resolve_session(arg: str | None) -> Path:
    if arg:
        d = ROOT / arg if not Path(arg).is_absolute() else Path(arg)
        if d.is_dir():
            return d
        sys.exit(f"no such session: {arg}")
    d = latest_session()
    if not d:
        sys.exit("no review session yet; run: review open <file>")
    return d


def slug(text: str, limit: int = 40) -> str:
    """A file-name-safe piece of a title, for a human reading the session directory."""
    return re.sub(r"\W+", "_", text).strip("_")[:limit] or "file"


def clear_assets(adir: Path, keep: set[Path]) -> None:
    """Empty the session's asset folder, except for files that are themselves inputs.

    TWO DEFECTS LIVED HERE, both measured 2026-10-02 against the old renderer, which wrote one PNG
    per PDF page and collected them back with the glob `<stem>*.png`:

      * A PDF that shrank from 6 pages to 3 came back with 6. The renderer overwrote three files
        and the glob picked up the three left over from the round before. The reviewer approved
        pages that no longer existed.
      * `doc.pdf` opened together with `doc-summary.png` showed that image twice, once as a page of
        the PDF, because `doc*.png` matches `doc-summary.png`.

    Both are gone by construction now: nothing is globbed, and every open re-stages from the
    current file into a name derived from the document's position in the session. This function is
    the belt to that pair of braces, so a file from an earlier round cannot survive in the folder
    and be served by name.
    """
    if not adir.exists():
        return
    for p in sorted(adir.iterdir()):
        if p.resolve() in keep:
            continue                    # reviewing a file that already lives in the session folder
        if p.is_dir():
            shutil.rmtree(p, ignore_errors=True)
        else:
            p.unlink(missing_ok=True)


PML = "{http://schemas.openxmlformats.org/presentationml/2006/main}"
DML = "{http://schemas.openxmlformats.org/drawingml/2006/main}"
RELS = "{http://schemas.openxmlformats.org/package/2006/relationships}"
R_ID = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"


def _rel_targets(z: zipfile.ZipFile, part: str) -> dict[str, str]:
    """Relationship id -> absolute part name, for one part of an OOXML package."""
    folder, name = part.rsplit("/", 1)
    rels = f"{folder}/_rels/{name}.rels"
    if rels not in z.namelist():
        return {}
    out = {}
    for rel in ET.fromstring(z.read(rels)).iter(f"{RELS}Relationship"):
        target = rel.get("Target", "")
        out[rel.get("Id")] = posixpath.normpath(posixpath.join(folder, target)).lstrip("/")
    return out


def pptx_notes(pptx: Path) -> list[str]:
    """The speaker notes of every slide, in presentation order; "" for a slide without notes.

    A PDF of a deck carries no notes, so a review of the PDF alone never shows the talk track.
    """
    with zipfile.ZipFile(pptx) as z:
        pres = "ppt/presentation.xml"
        targets = _rel_targets(z, pres)
        notes = []
        for sld in ET.fromstring(z.read(pres)).iter(f"{PML}sldId"):
            slide = targets.get(sld.get(R_ID), "")
            note_part = next((t for t in _rel_targets(z, slide).values() if "notesSlide" in t), None)
            if not note_part or note_part not in z.namelist():
                notes.append("")
                continue
            paras = []
            for sp in ET.fromstring(z.read(note_part)).iter(f"{PML}sp"):
                ph = sp.find(f".//{PML}ph")
                if ph is None or ph.get("type") != "body":
                    continue  # the slide image and the slide number are not the talk track
                for para in sp.iter(f"{DML}p"):
                    paras.append("".join(t.text or "" for t in para.iter(f"{DML}t")))
            notes.append("\n".join(paras).strip())
        return notes


def office_to_pdf(src: Path, dest: Path, timeout: float = 30) -> Path | None:
    soffice = shutil.which("soffice") or shutil.which("libreoffice")
    if not soffice:
        what = "slides" if src.suffix.lower() == ".pptx" else "pages"
        print(f"skipping {src.name}: needs LibreOffice (soffice) to render {what}", file=sys.stderr)
        return None
    with tempfile.TemporaryDirectory() as tmp:
        tmp_path = Path(tmp)
        profile_dir = tmp_path / "profile"
        conv_dir = tmp_path / "out"
        conv_dir.mkdir(parents=True, exist_ok=True)
        cmd = [
            soffice,
            f"-env:UserInstallation=file://{profile_dir.resolve()}",
            "--headless",
            "--convert-to", "pdf",
            "--outdir", str(conv_dir),
            str(src.resolve()),
        ]
        try:
            res = subprocess.run(cmd, capture_output=True, timeout=timeout)
            if res.returncode != 0:
                print(f"skipping {src.name}: LibreOffice conversion failed (exit {res.returncode})", file=sys.stderr)
                return None
        except subprocess.TimeoutExpired:
            print(f"skipping {src.name}: LibreOffice conversion timed out after {timeout}s", file=sys.stderr)
            return None
        except OSError as exc:
            print(f"skipping {src.name}: failed to run LibreOffice: {exc}", file=sys.stderr)
            return None

        converted = conv_dir / f"{src.stem}.pdf"
        if not converted.is_file() or converted.stat().st_size == 0:
            print(f"skipping {src.name}: LibreOffice wrote no PDF for it", file=sys.stderr)
            return None
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(converted, dest)
        return dest


def notes_html(notes: list[str]) -> str:
    blocks = []
    for k, text in enumerate(notes, start=1):
        body = "".join(f"<p>{html_mod.escape(line)}</p>" for line in text.split("\n") if line.strip())
        blocks.append(f"<h3>Slide {k}</h3>{body or '<p><em>no speaker notes</em></p>'}")
    return "".join(blocks)


def file_sha256(path: Path) -> str:
    """The SHA-256 of a file, read in pieces. A video master can be gigabytes, and `read_bytes()`
    held all of it in memory, once at staging and again at Send."""
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


# --------------------------------------------------------------------------- video
# What every current browser plays, by container. Anything outside it is converted ONCE, at
# staging, into H.264 and AAC in MP4, the one combination Chrome, Edge, Safari and Firefox all
# play. Chrome plays HEVC only with a hardware decoder (never on a headless Linux box), Safari
# plays AV1 only on recent Apple silicon, and no browser plays ProRes, so none of them is safe.
# 8-bit 4:2:0 only: a 10-bit H.264 file is valid and still refused by most decoders.
PLAYABLE = {
    "mp4": ({"h264"}, {"aac", "mp3", None}),
    "webm": ({"vp8", "vp9"}, {"opus", "vorbis", None}),
}
PLAYABLE_PIX = {"yuv420p", "yuvj420p"}


def _rate(text) -> float | None:
    """ffprobe's "30000/1001" as 29.97. "0/0" and garbage are None, never a division error."""
    try:
        num, _, den = str(text).partition("/")
        value = float(num) / float(den or 1)
    except (ValueError, ZeroDivisionError):
        return None
    # Above 240 it is a timebase, not a frame rate: a MediaRecorder WebM reports 1000/1, and a
    # frame step of one millisecond would not move the picture at all.
    return round(value, 3) if 0 < value <= 240 else None


def _rotation(stream: dict) -> int:
    """The display rotation of a stream in degrees, from the side data or the older tag."""
    for side in stream.get("side_data_list") or []:
        if "rotation" in side:
            try:
                return int(round(float(side["rotation"]))) % 360
            except (TypeError, ValueError):
                pass
    try:
        return int(round(float((stream.get("tags") or {}).get("rotate", 0)))) % 360
    except (TypeError, ValueError):
        return 0


def probe_video(path: Path) -> dict | None:
    """What ffprobe says about a video, or None when ffprobe is missing or cannot read the file.

    The size is the DISPLAY size: a phone records a portrait Short as landscape pixels plus a
    90-degree rotation, and the browser shows it rotated. The frame rate is the average one;
    `r_frame_rate` is only a guess at a rate that represents every timestamp, and it reads 90000
    on some phone files.
    """
    exe = shutil.which("ffprobe")
    if not exe:
        return None
    try:
        out = subprocess.run([exe, "-v", "error", "-print_format", "json", "-show_format",
                              "-show_streams", str(path)], capture_output=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        return None if isinstance(e, OSError) else {"vcodec": None, "error": "ffprobe timed out"}
    try:
        data = json.loads(out.stdout or b"{}") if out.returncode == 0 else None
    except ValueError:
        data = None
    if not isinstance(data, dict):
        # ffprobe ran and could not read the file: damaged, or not a video at all. A browser
        # will not play it either, so it is skipped with ffprobe's own words.
        why = out.stderr.decode(errors="replace").strip().splitlines()[-1:] or ["unreadable"]
        return {"vcodec": None, "error": why[0][:160]}
    streams = [s for s in data.get("streams") or [] if isinstance(s, dict)]
    video = next((s for s in streams if s.get("codec_type") == "video"
                  and not (s.get("disposition") or {}).get("attached_pic")), None)
    audio = next((s for s in streams if s.get("codec_type") == "audio"), None)
    fmt = data.get("format") or {}
    try:
        duration = float(fmt.get("duration") or (video or {}).get("duration") or 0) or None
    except (TypeError, ValueError):
        duration = None
    if not video:
        return {"vcodec": None, "acodec": audio and audio.get("codec_name"), "duration": duration}
    width, height = int(video.get("width") or 0), int(video.get("height") or 0)
    sar = _rate(str(video.get("sample_aspect_ratio") or "1:1").replace(":", "/"))
    if sar and sar != 1:
        width = int(round(width * sar))          # anamorphic pixels, shown wider than stored
    if _rotation(video) % 180 == 90:
        width, height = height, width
    return {"vcodec": video.get("codec_name"), "pix_fmt": video.get("pix_fmt"),
            "acodec": audio.get("codec_name") if audio else None,
            "width": width or None, "height": height or None,
            "fps": _rate(video.get("avg_frame_rate")) or _rate(video.get("r_frame_rate")),
            "duration": duration}


def video_plan(probe: dict | None, suffix: str) -> dict:
    """Copy, remux or convert, and why. A pure function, so every codec case is a unit test.

    `action` is "copy" (the file as it is), "remux" (same streams, MP4 container) or "convert"
    (ffmpeg writes an MP4, re-encoding only the stream that needs it). Without a probe nothing
    is known, so the file is copied and the page reports it if the browser refuses it.
    """
    if probe is None:
        return {"action": "copy", "why": "ffprobe is not installed"}
    vcodec, acodec, pix = probe.get("vcodec"), probe.get("acodec"), probe.get("pix_fmt")
    family = "webm" if suffix == ".webm" else "mp4"
    vids, auds = PLAYABLE[family]
    video_ok = vcodec in vids and pix in PLAYABLE_PIX
    audio_ok = acodec in auds
    if video_ok and audio_ok:
        if suffix == ".mov":
            return {"action": "remux", "ext": ".mp4",
                    "why": "a QuickTime file, as MP4 with the same streams"}
        if family == "webm" and not probe.get("duration"):
            # A MediaRecorder WebM has no duration and no cues, so the browser reports Infinity
            # and cannot seek. Copying the streams into a new WebM writes both.
            return {"action": "remux", "ext": ".webm",
                    "why": "a WebM without a duration, rewritten so it can be seeked"}
        return {"action": "copy", "why": "plays as it is"}
    # An MP4 needs H.264; a VP9 WebM with odd audio is re-encoded whole rather than mixed.
    keep_video = vcodec == "h264" and pix in PLAYABLE_PIX
    keep_audio = acodec in PLAYABLE["mp4"][1]
    why = []
    if not keep_video:
        why.append(f"{vcodec or 'unknown'} video" + (f" ({pix})" if pix else ""))
    if not keep_audio:
        why.append(f"{acodec} audio")
    return {"action": "convert", "ext": ".mp4", "video": "copy" if keep_video else "encode",
            "audio": "none" if acodec is None else ("copy" if keep_audio else "encode"),
            "why": " and ".join(why) + " does not play in every browser"}


def ffmpeg_command(exe: str, plan: dict, src: Path, out: Path) -> list[str]:
    """The ffmpeg line for a remux or a conversion.

    Only the first picture and the first sound go in: a QuickTime timecode or data track cannot
    be copied into MP4 and fails the whole run. Even dimensions, because 4:2:0 H.264 cannot have
    an odd width, and `-pix_fmt yuv420p`, because libx264 keeps 10-bit input at 10 bits, which a
    browser refuses. `+faststart` puts the index at the front of the file.
    """
    remux = plan["action"] == "remux"
    # `V`, not `v`: a capital V skips cover art, which a QuickTime or M4V file can carry as its
    # first video stream, and which would otherwise become the whole "video".
    cmd = [exe, "-hide_banner", "-loglevel", "error", "-nostdin", "-y", "-i", str(src),
           "-map", "0:V:0", "-map", "0:a:0?", "-sn", "-dn"]
    if remux or plan.get("video") == "copy":
        cmd += ["-c:v", "copy"]
    else:
        cmd += ["-c:v", "libx264", "-preset", "veryfast", "-crf", "18", "-pix_fmt", "yuv420p",
                "-vf", "scale=trunc(iw/2)*2:trunc(ih/2)*2"]
    if remux or plan.get("audio") in ("copy", "none"):
        cmd += ["-c:a", "copy"]
    else:
        cmd += ["-c:a", "aac", "-b:a", "192k"]
    if out.suffix == ".mp4":
        cmd += ["-movflags", "+faststart"]
    return cmd + [str(out)]


# Part of the cache key. Raise it when ffmpeg_command changes, or a session keeps playing a copy
# made by the old arguments.
CONVERT_RECIPE = "1"


def _link_or_copy(src: Path, dest: Path) -> None:
    """A conversion from the session's own cache, put into `assets/`: a hard link where the file
    system allows it, else a copy. Only for the cache: ffmpeg's `-y` rewrites its output in place,
    so a hard link to a SOURCE would change the file under a live review on the next render."""
    dest.unlink(missing_ok=True)
    try:
        os.link(src, dest)
    except OSError:
        shutil.copy2(src, dest)


def _copy(src: Path, dest: Path) -> None:
    if src.resolve() != dest.resolve():
        shutil.copy2(src, dest)


def stage_video(src: Path, sess: Path, adir: Path, ident: str, asset: str,
                source_hash: str, used: set) -> dict | None:
    """One video item. A conversion is cached in the session under the source's hash, so the next
    round on the same bytes plays at once, and a re-rendered file is converted afresh. `clear_assets`
    empties `assets/` on every open, so the cache lives beside it, in `converted/`."""
    suffix = src.suffix.lower()
    probe = probe_video(src)
    if probe is not None and not probe.get("vcodec"):
        why = f"ffprobe cannot read it ({probe['error']})" if probe.get("error") \
            else "it has no video stream"
        print(f"skipping {src.name}: {why}", file=sys.stderr)
        return None
    plan = video_plan(probe, suffix)
    converted, dest = None, adir / f"{asset}{suffix}"
    if plan["action"] == "copy":
        _copy(src, dest)
        if probe is None:
            print(f"note: {src.name} is staged as it is, because ffprobe is not installed. "
                  "If the browser cannot play it, install ffmpeg and open it again.",
                  file=sys.stderr)
    else:
        cache = sess / "converted"
        cache.mkdir(exist_ok=True)
        key = f"{source_hash[:24]}_r{CONVERT_RECIPE}"
        done = cache / f"{key}{plan['ext']}"
        used.add(done.name)
        exe = shutil.which("ffmpeg")
        if not done.exists() and exe:
            print(f"converting {src.name} for the browser: {plan['why']}. "
                  "Once per version of the file.", file=sys.stderr)
            part = cache / f"{key}.part{plan['ext']}"
            try:
                run = subprocess.run(ffmpeg_command(exe, plan, src, part),
                                     capture_output=True, timeout=3600)
                if run.returncode == 0 and part.exists() and part.stat().st_size:
                    part.replace(done)
                else:
                    tail = run.stderr.decode(errors="replace").strip().splitlines()[-1:] or [""]
                    print(f"warning: ffmpeg could not convert {src.name} ({tail[0][:160]})",
                          file=sys.stderr)
            except (OSError, subprocess.SubprocessError) as e:
                print(f"warning: ffmpeg could not convert {src.name} ({e})", file=sys.stderr)
            part.unlink(missing_ok=True)
        if done.exists():
            dest = adir / f"{asset}{plan['ext']}"
            _link_or_copy(done, dest)
            converted = plan["action"] if plan["action"] == "remux" else "h264"
            probe = probe_video(dest) or probe
        else:
            if not exe:
                print(f"warning: {src.name} needs ffmpeg to play in a browser ({plan['why']}); "
                      "it is staged as it is", file=sys.stderr)
            _copy(src, dest)
    probe = probe or {}
    # The hash in the address: on a fixed port two rounds share every asset name, and a browser
    # media cache that joins byte ranges by address could mix the old render with the new one.
    return {"kind": "video", "id": ident, "asset": asset, "name": src.name,
            "url": f"/asset/{dest.name}?v={source_hash[:12]}", "source": str(src.resolve()),
            "source_sha256": source_hash, "duration": probe.get("duration"),
            "fps": probe.get("fps"), "width": probe.get("width"), "height": probe.get("height"),
            "converted": converted, "played": str(dest)}


def stage_inputs(paths: list[Path], sess: Path) -> list[dict]:
    """One item per DOCUMENT, never per page.

    A PDF is copied as a PDF and the browser draws its pages, so this knows nothing about page
    counts and cannot get them wrong. Each document gets an id from its position in the session
    (`d1`, `d2`, …) and an asset name that carries that id, which is also why two files with one
    name in different folders stay two documents here instead of overwriting each other.
    """
    adir = sess / "assets"
    adir.mkdir(parents=True, exist_ok=True)
    clear_assets(adir, {p.resolve() for p in paths if p.exists()})
    items: list[dict] = []
    used_conversions: set = set()

    def base(stem: str) -> tuple[str, str]:
        ident = f"d{len(items) + 1}"
        return ident, f"{ident}_{slug(stem)}"

    for src in paths:
        if not src.exists():
            sys.exit(f"no such file: {src}")
        suffix = src.suffix.lower()
        if suffix in (".pptx", ".docx"):
            if not zipfile.is_zipfile(src):
                doc_type = "PowerPoint deck" if suffix == ".pptx" else "Word document"
                print(f"skipping {src.name}: password-protected {doc_type} is not a zip", file=sys.stderr)
                continue
            ident, asset = base(src.stem)
            dest = adir / f"{asset}.pdf"
            pdf = office_to_pdf(src, dest)
            if pdf is None:
                continue
            source_hash = file_sha256(src)
            if suffix == ".pptx":
                items.append({"kind": "media", "format": "pdf", "id": ident, "asset": asset,
                              "name": src.name, "url": f"/asset/{dest.name}",
                              "source": str(src.resolve()), "page_label": "slide", "deck": True,
                              "source_sha256": source_hash})
                ident, asset = base(f"{src.stem}_notes")
                items.append({"kind": "text", "id": ident, "asset": asset,
                              "name": f"{src.stem} speaker notes", "format": "html",
                              "html": notes_html(pptx_notes(src)), "source": str(src.resolve()),
                              "notes_of": str(src.resolve()), "source_sha256": source_hash})
            else:
                items.append({"kind": "media", "format": "pdf", "id": ident, "asset": asset,
                              "name": src.name, "url": f"/asset/{dest.name}",
                              "source": str(src.resolve()), "page_label": "page",
                              "source_sha256": source_hash})
            continue
        source_hash = file_sha256(src)
        if suffix == ".pdf":
            ident, asset = base(src.stem)
            dest = adir / f"{asset}.pdf"
            if src.resolve() != dest.resolve():
                shutil.copy2(src, dest)
            items.append({"kind": "media", "format": "pdf", "id": ident, "asset": asset,
                          "name": src.name, "url": f"/asset/{dest.name}",
                          "source": str(src.resolve()), "page_label": "page",
                          "source_sha256": source_hash})
            continue
        if suffix in IMAGE_SUFFIXES:
            ident, asset = base(src.stem)
            dest = adir / f"{asset}{suffix}"
            if src.resolve() != dest.resolve():
                shutil.copy2(src, dest)
            items.append({"kind": "media", "format": "image", "id": ident, "asset": asset,
                          "name": src.name, "url": f"/asset/{dest.name}",
                          "source": str(src.resolve()),
                          "source_sha256": source_hash})
            continue
        if suffix in VIDEO_SUFFIXES:
            ident, asset = base(src.stem)
            item = stage_video(src, sess, adir, ident, asset, source_hash, used_conversions)
            if item:
                items.append(item)
            continue
        if suffix in TEXT_SUFFIXES:
            raw = src.read_text(errors="replace")
            if suffix in (".html", ".htm"):
                body, fmt = html_body(raw), "html"
            elif suffix == ".txt":
                body = "".join(f"<p>{html_mod.escape(p)}</p>"
                               for p in re.split(r"\n\s*\n", raw) if p.strip())
                fmt = "text"
            else:
                body, fmt = render_markdown(raw), "markdown"
            ident, asset = base(src.stem)
            items.append({"kind": "text", "id": ident, "asset": asset,
                          "name": src.name, "format": fmt, "html": body,
                          "source": str(src.resolve()),
                          "source_sha256": source_hash})
            continue
        print(f"skipping {src.name}: reviewable types are images, video, PDF, PowerPoint, Word, "
              "Markdown, HTML, txt", file=sys.stderr)
    # A conversion nobody in this round uses is the previous version of a file. Gone, or the
    # session folder grows by one video per render.
    for old in (sess / "converted").iterdir() if (sess / "converted").is_dir() else ():
        if old.is_file() and old.name not in used_conversions:
            old.unlink(missing_ok=True)
    if not items:
        sys.exit("nothing to review among the given files")
    (sess / "items.json").write_text(json.dumps(items, indent=2))
    return items


# --------------------------------------------------------------------------- batch
def timecode(t: float) -> str:
    """Seconds as M:SS.cc (H:MM:SS.cc from an hour on), the label the reviewer saw. ffmpeg's
    `-ss` reads the same string."""
    cs = int(max(0.0, t) * 100 + 0.5)       # half up, as the page's Math.round; round() is half even
    s, cs = divmod(cs, 100)
    m, s = divmod(s, 60)
    h, m = divmod(m, 60)
    return f"{h}:{m:02d}:{s:02d}.{cs:02d}" if h else f"{m}:{s:02d}.{cs:02d}"


def data_image(value) -> tuple[bytes, str] | None:
    """The bytes and file suffix of a PNG or JPEG data URL from the page, else None. Nothing else
    is written to disk under a name the agent will open."""
    if not isinstance(value, str):
        return None
    for prefix, suffix in (("data:image/png;base64,", ".png"), ("data:image/jpeg;base64,", ".jpg")):
        if value.startswith(prefix):
            try:
                return base64.b64decode(value[len(prefix):], validate=True), suffix
            except ValueError:
                return None
    return None


def _seconds(value) -> float | None:
    try:
        t = float(value)
    except (TypeError, ValueError):
        return None
    return t if t == t and abs(t) != float("inf") else None


def video_marks(sess: Path, item: dict, page: dict, lines: list) -> dict:
    """The marks of one video, with their frames on disk.

    The page sends each moment's frame ONCE (`frames`, keyed), because three notes on one frame
    are one picture, and the marks point at it. Every time label is worked out here from `t`,
    not taken from the page, so the label and the number cannot disagree. Only tools the page
    can make are carried: a mark with any other tool keeps its note and loses its geometry.
    """
    frames_dir, crops_dir = sess / "frames", sess / "crops"
    frames_dir.mkdir(exist_ok=True)
    crops_dir.mkdir(exist_ok=True)
    stem = item.get("asset") or slug(Path(page.get("name") or "video").stem)
    fps, duration = item.get("fps"), item.get("duration")
    written: dict = {}

    def frame_file(key) -> str | None:
        if key in written:
            return written[key]
        raw = next((f.get("image") for f in page.get("frames") or []
                    if isinstance(f, dict) and f.get("key") == key), None)
        img = data_image(raw)
        t = _seconds(key)
        if not img or t is None:
            return None
        path = frames_dir / f"{stem}_at_{int(round(max(0.0, t) * 1000)):08d}ms{img[1]}"
        path.write_bytes(img[0])
        written[key] = str(path)
        return written[key]

    def at(t: float, suffix: str = "") -> dict:
        out = {f"t{suffix}": round(t, 3), f"timecode{suffix}": timecode(t)}
        if fps:
            # t is the start of the frame on screen; the small lift keeps a float a hair below
            # an exact frame boundary from landing on the frame before.
            out[f"frame_number{suffix}"] = int(t * fps + 1e-3)
        if duration and t > duration + (1 / fps if fps else 0.05):
            out[f"past_end{suffix}"] = True     # drawn on a longer version of the file
        return out

    marks = []
    for c in page.get("comments", []):
        if not isinstance(c, dict):
            continue
        tool = c.get("tool") if c.get("tool") in VIDEO_TOOLS else "note"
        t = max(0.0, _seconds(c.get("t")) or 0.0)
        mark = {"id": c.get("id"), "number": c.get("number"), "tool": tool,
                "note": str(c.get("note") or "").strip(), **at(t)}
        start_key, end_key = c.get("frame"), c.get("frame_end")
        if tool == "span":
            end = _seconds(c.get("t_end"))
            end = max(0.0, end) if end is not None else t
            if end < t:                         # drawn backward: the frames turn with the times
                t, end, start_key, end_key = end, t, end_key, start_key
            mark.update(at(t))
            mark.update(at(end, "_end"))
        if tool in DRAFT_TOOLS and isinstance(c.get("box"), dict):
            mark["box"] = {k: _seconds(c["box"].get(k)) for k in ("x", "y", "w", "h")}
        mark["frame"] = frame_file(start_key)
        if tool == "span":
            mark["frame_end"] = frame_file(end_key)
        crop = data_image(c.get("crop")) if tool in DRAFT_TOOLS else None
        if crop and isinstance(mark["number"], int):
            path = crops_dir / f"{stem}_mark_{mark['number']:02d}{crop[1]}"
            path.write_bytes(crop[0])
            mark["crop"] = str(path)
        marks.append(mark)
        when = mark["timecode"] + (f" to {mark['timecode_end']}" if tool == "span" else "")
        lines.append(f"{mark['number']}. [{when}] ({tool}) {mark['note'] or '[no text]'}")
        for label in ("frame", "frame_end", "crop"):
            if mark.get(label):
                lines.append(f"   {label.replace('_', ' ')}: `{mark[label]}`")
    out = {"marks": marks, "duration": duration, "fps": fps,
           "width": item.get("width"), "height": item.get("height")}
    if item.get("converted"):
        out["played"] = item.get("played")     # the copy the browser played, and t is on it
        out["converted"] = item["converted"]
    return out


def write_outputs(sess: Path, payload: dict) -> dict:
    crops_dir = sess / "crops"
    crops_dir.mkdir(exist_ok=True)
    try:
        staged = {i["id"]: i for i in json.loads((sess / "items.json").read_text())}
    except (OSError, ValueError):
        staged = {}

    lines = ["# Review", ""]
    pages_out = []
    for page in payload.get("pages", []):
        # Keyed by the document id, never by the name. A page of a PDF is labelled
        # "statement.pdf, page 2", two inputs can carry one file name, and neither is a key.
        item = staged.get(page.get("item"), {})
        src = item.get("source")
        name = page.get("name") or item.get("name") or page.get("item")
        entry = {"kind": page["kind"], "name": name, "source": src}
        number = page.get("page")
        if item.get("format") == "pdf" and number:
            entry.update({"document": item.get("name"), "page": number,
                          "pages": page.get("pages")})
            if item.get("deck"):
                entry["slide"] = number     # a deck page: edits map back to this slide
        heading = f"{name} of {page['pages']}" if number and page.get("pages") else name
        lines += [f"## {heading}", ""]
        if src:
            lines.append(f"Original: `{src}`")

        if page["kind"] == "media":
            stem = item.get("asset") or slug(Path(name).stem)
            if number:
                stem = f"{stem}_p{number:02d}"
            over = sess / f"overview_{stem}.png"
            over.write_bytes(base64.b64decode(page["overview_png"].split(",", 1)[1]))
            by_id = {c["mark"]: c for c in page.get("crops", [])}
            lines += [f"Overview: `{over}`", ""]
            marks = []
            for c in page["comments"]:
                crop = crops_dir / f"{stem}_mark_{c['number']:02d}.png"
                raw = by_id.get(int(c["id"].split("_")[1]), {}).get("png")
                if raw:
                    crop.write_bytes(base64.b64decode(raw.split(",", 1)[1]))
                mark = {"id": c["id"], "number": c["number"], "tool": c["tool"],
                        "note": c["note"].strip(), "box": c["box"],
                        "crop": str(crop) if raw else None}
                # A mark made by selecting text in a PDF carries what was selected, so the agent
                # gets the exact words as well as the picture. Drawn marks have none of this.
                for extra in ("quote", "anchor", "rects"):
                    if c.get(extra) is not None:
                        mark[extra] = c[extra]
                marks.append(mark)
                quoted = f' "{c["quote"][:70]}"' if c.get("quote") else ""
                lines.append(f"{c['number']}. ({c['tool']}){quoted} "
                             f"{c['note'].strip() or '[no text]'}")
                if raw:
                    lines.append(f"   crop: `{crop}`")
            entry.update({"overview": str(over), "marks": marks})
        elif page["kind"] == "video":
            entry.update(video_marks(sess, item, page, lines))
        else:
            comments, edits = [], []
            for c in page.get("comments", []):
                # A selection over several blocks lists them in `blocks`, and its text per block in
                # `parts`. A circle, box, scribble or arrow drawn on the draft has a `tool`, the words
                # under it and a `box`, and an EMPTY anchor: a shape has no exact character span, and
                # a reader that indexes anchor["prefix"] on every comment keeps working. Only values
                # the page can produce are carried, since an agent reads this file as instructions.
                blocks = [b for b in (c.get("blocks") or [c.get("block")])
                          if isinstance(b, str)] or [None]
                tool = c.get("tool") if c.get("tool") in DRAFT_TOOLS else None
                comment = {"id": c["id"], "number": c["number"], "quote": c["quote"],
                           "anchor": {"prefix": "", "suffix": ""} if tool else c.get("anchor", {}),
                           "block": blocks[0], "note": c["note"].strip()}
                if tool:
                    comment["tool"] = tool
                    if isinstance(c.get("box"), dict):
                        comment["box"] = c["box"]
                if len(blocks) > 1:
                    comment["blocks"] = blocks
                    parts = c.get("parts")
                    if isinstance(parts, list) and all(
                            isinstance(p, dict) and isinstance(p.get("block"), str)
                            and isinstance(p.get("quote"), str) for p in parts):
                        comment["parts"] = [{"block": p["block"], "quote": p["quote"]}
                                            for p in parts]
                comments.append(comment)
                how = f"[{tool}] " if tool else ""
                quote = c["quote"].replace("\n", " / ")[:70]
                lines.append(f"{c['number']}. {how}\"{quote}\" -> {c['note'].strip() or '[no text]'}")
            for e in page.get("edits", []):
                edits.append({"block": e.get("block"), "label": e.get("label"),
                              "before": e["before"], "after": e["after"]})
                lines.append(f"EDIT [{e.get('label') or e.get('block')}]")
                lines.append(f"   before: {e['before'][:110]}")
                lines.append(f"   after:  {e['after'][:110]}")
            entry.update({"comments": comments, "edits": edits, "edits_saved": False})
        lines.append("")
        pages_out.append(entry)

    batch = {"status": "feedback", "session": sess.name, "pages": pages_out,
             "overall_note": payload.get("overall_note", "").strip(),
             "received_at": time.strftime("%Y-%m-%dT%H:%M:%S")}
    if batch["overall_note"]:
        lines += ["## Overall", "", batch["overall_note"], ""]
    (sess / "marks.md").write_text("\n".join(lines))
    (sess / "batch.json").write_text(json.dumps(batch, indent=2, ensure_ascii=False))
    # Receipt: a fact other gates can read, instead of a claim that he looked.
    files = sorted({p["source"] for p in pages_out if p.get("source")})
    # The hash pins WHICH bytes were reviewed: a rebuilt deck at the same path is a new review.
    staged_by_src = {}
    for it in staged.values():
        src = it.get("source")
        if src and (src not in staged_by_src or it.get("source_sha256")):
            staged_by_src[src] = it
    hashes = {}
    for f in files:
        pf = Path(f)
        if not pf.is_file():
            continue
        curr = file_sha256(pf)
        staged_item = staged_by_src.get(f)
        staged_hash = staged_item.get("source_sha256") if staged_item else None
        if staged_hash:
            if curr != staged_hash:
                print(f"warning: {pf.name} changed on disk since review opened", file=sys.stderr)
            hashes[f] = staged_hash
        else:
            hashes[f] = curr
    (sess / "receipt.json").write_text(json.dumps(
        {"reviewed_at": batch["received_at"],
         "files": files,
         "sha256": hashes,
         "items": sum(len(p.get("marks", [])) + len(p.get("comments", [])) + len(p.get("edits", []))
                      for p in pages_out)}, indent=2))
    return batch


# --------------------------------------------------------------------------- server
# A page may close its own tab only while that tab has one history entry, and the browser does not
# care whether a click or a key sent the batch: a review opened in a tab that already showed a page
# stays open. From outside the page the tab can still be closed, through the scripting interface of
# the browsers this was tested with.
BROWSERS = ("com.google.Chrome", "com.microsoft.edgemac")

# Why every running copy, by process id: see the header of close-tabs.js.
CLOSE_TABS = Path(__file__).resolve().parent / "close-tabs.js"


def automation_allowed(bundle_id: str) -> bool:
    """True when that app runs and this process may already script it. Never asks.

    A permission prompt is the one outcome worse than a tab left open: "Terminal wants access to
    control Google Chrome", out of nowhere, the moment somebody sends a review. So only a grant made
    earlier counts. The status is 0 when granted, -1744 when it would ask, -1743 when denied, and
    -600 when the app is not running.
    """
    try:
        import ctypes           # here: a Python built without _ctypes must still run every command
        cs = ctypes.CDLL("/System/Library/Frameworks/CoreServices.framework/CoreServices")
    except (ImportError, OSError):
        return False

    class AEDesc(ctypes.Structure):
        # AEDataModel.h packs to 2: 12 bytes, the handle at offset 4 (measured with clang on arm64).
        # ctypes packs only in its "ms" layout, which gives the same offsets for these two fields.
        _pack_, _layout_ = 2, "ms"
        _fields_ = [("descriptorType", ctypes.c_uint32), ("dataHandle", ctypes.c_void_p)]

    cs.AECreateDesc.argtypes = [ctypes.c_uint32, ctypes.c_char_p, ctypes.c_long,
                                ctypes.POINTER(AEDesc)]
    cs.AECreateDesc.restype = ctypes.c_int16
    cs.AEDeterminePermissionToAutomateTarget.argtypes = [ctypes.POINTER(AEDesc), ctypes.c_uint32,
                                                         ctypes.c_uint32, ctypes.c_bool]
    cs.AEDeterminePermissionToAutomateTarget.restype = ctypes.c_int32
    cs.AEDisposeDesc.argtypes = [ctypes.POINTER(AEDesc)]
    code = lambda four: int.from_bytes(four, "big")      # an Apple four-character code
    desc, raw = AEDesc(), bundle_id.encode()
    if cs.AECreateDesc(code(b"bund"), raw, len(raw), ctypes.byref(desc)):
        return False
    try:
        return cs.AEDeterminePermissionToAutomateTarget(
            ctypes.byref(desc), code(b"****"), code(b"****"), False) == 0
    finally:
        cs.AEDisposeDesc(ctypes.byref(desc))


def close_tab(urls: tuple[str, str]) -> int:
    """Close every tab showing one of `urls`, in every running copy of each browser this process
    may already script. macOS only. Returns how many tabs it closed.

    The bundle ids come from BROWSERS and never from a request, and everything goes in as an
    argument. The URLs are this server's own address, so no request chooses which tabs close.
    """
    if sys.platform != "darwin" or not shutil.which("osascript"):
        return 0
    closed = 0
    for bundle_id in filter(automation_allowed, BROWSERS):
        try:
            r = subprocess.run(["osascript", "-l", "JavaScript", str(CLOSE_TABS), bundle_id, *urls],
                               capture_output=True, text=True, timeout=5)
            closed += int(r.stdout.strip()) if r.returncode == 0 else 0
        except (OSError, subprocess.TimeoutExpired, ValueError):
            pass
    return closed


LOOPBACK = ("127.0.0.1", "localhost")


def foreign(method: str, headers) -> bool:
    """True for a request that a browser sends on behalf of another site.

    Any web page can POST to 127.0.0.1, and a page whose DNS name was rebound to 127.0.0.1 can even
    read the answers. Host names the address the browser thinks it talks to, and Sec-Fetch-Site or
    Origin names the page that asked. A local tool such as curl sends neither of the last two, and
    it can read the session directory anyway. A port forward keeps the host 127.0.0.1.
    """
    if urlsplit("//" + (headers.get("Host") or "")).hostname not in LOOPBACK:
        return True
    if method != "POST":
        return False
    site, origin = headers.get("Sec-Fetch-Site"), headers.get("Origin")
    if site is not None:
        return site != "same-origin"
    return origin is not None and urlsplit(origin).hostname not in LOOPBACK


# The page carries one vendored dependency (PDF.js) that parses documents nobody vetted, so the
# page is locked down rather than trusted: nothing loads from anywhere but this server, nothing can
# call out, and the only scripts that run are the two this server stamps with a fresh nonce. The
# nonce is also what keeps an `onclick=` or a `javascript:` link inside a REVIEWED HTML draft from
# running, which plain 'unsafe-inline' would allow. Images are 'self' too, so a remote image in a
# draft stays blank instead of telling its host that the draft was opened.
CSP = ("default-src 'none'; script-src 'nonce-{nonce}'; style-src 'self' 'unsafe-inline'; "
       "img-src 'self' data: blob:; media-src 'self'; connect-src 'self'; "
       "worker-src 'self' blob:; font-src 'self' data:; base-uri 'none'; form-action 'none'; "
       "frame-ancestors 'none'")
# Where the server writes the session globals. A literal <script> would be ambiguous once the page
# gained a second one, and the module script cannot be the injection point because its opening tag
# is not the bare string.
BOOT = "/*__BOOT__*/"


def content_type(path: Path) -> str:
    return CONTENT_TYPES.get(path.suffix.lower(), "application/octet-stream")


def byte_range(header: str | None, size: int):
    """The one byte range a `Range` header asks for, as (first, last), both inclusive.

    None means "send the whole file with a 200", which is what a server may do with a header it
    does not understand, and what it does with several ranges at once. "unsatisfiable" means a 416.
    A browser playing video asks for `bytes=0-1` (Safari, before anything else), `bytes=N-` (every
    seek) and, rarely, `bytes=-N`, the last N bytes.
    """
    m = re.fullmatch(r"\s*bytes\s*=\s*(\d*)\s*-\s*(\d*)\s*", header or "")
    if not m or not (m.group(1) or m.group(2)):
        return None
    first, last = m.groups()
    if not first:                                  # a suffix: the last N bytes
        n = int(last)
        return (max(0, size - n), size - 1) if n and size else "unsatisfiable"
    first = int(first)
    if first >= size:
        return "unsatisfiable"
    last = min(int(last), size - 1) if last else size - 1
    return (first, last) if last >= first else None


def serve(sess: Path, items: list[dict], port: int = 0, test_js: str = "",
          ready=None) -> None:
    app = APP.read_text()
    sent = threading.Event()
    # The server answers several requests at once (see Server below), and these two routes check
    # and then act: a second tab must still not send twice, and a late draft save must still not
    # land after a Send.
    post_lock = threading.Lock()

    def stop(after: float) -> None:
        threading.Timer(after, lambda: os.kill(os.getpid(), signal.SIGTERM)).start()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *_a):
            pass

        def _send(self, code, body: bytes, ctype="text/html; charset=utf-8", extra=()):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            # Every asset is declared, so nothing has to be guessed from its bytes. A PDF that a
            # browser decides to treat as HTML is a cross-site scripting hole in this origin.
            self.send_header("X-Content-Type-Options", "nosniff")
            for key, value in extra:
                self.send_header(key, value)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _send_file(self, f: Path, head: bool = False):
            """An asset, streamed in pieces, with byte ranges for video.

            Safari plays no video from a server without ranges, and seeking needs them everywhere.
            They are ADVERTISED for video only: PDF.js switches to ranged loading when it sees
            `Accept-Ranges`, and the PDF path is tested and fast as it is.
            """
            ctype = content_type(f)
            size = f.stat().st_size
            ranged = ctype.startswith("video/")
            rng = byte_range(self.headers.get("Range"), size) if ranged else None
            if rng == "unsatisfiable":
                return self._send(416, b"", "text/plain", extra=(
                    ("Content-Range", f"bytes */{size}"), ("Accept-Ranges", "bytes")))
            first, last = rng or (0, size - 1)
            length = last - first + 1 if size else 0
            self.send_response(206 if rng else 200)
            self.send_header("Content-Type", ctype)
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Length", str(length))
            if ranged:
                self.send_header("Accept-Ranges", "bytes")
            if rng:
                self.send_header("Content-Range", f"bytes {first}-{last}/{size}")
            self.end_headers()
            if head:
                return
            # A browser drops a media connection the moment it seeks elsewhere, so a broken pipe
            # here is normal and says nothing.
            with contextlib.suppress(BrokenPipeError, ConnectionResetError), f.open("rb") as fh:
                fh.seek(first)
                left = length
                while left > 0:
                    chunk = fh.read(min(1 << 18, left))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    left -= len(chunk)

        def _asset(self) -> Path | None:
            # The browser percent-encodes the name ("a b.png" arrives as "a%20b.png").
            f = sess / "assets" / Path(unquote(self.route[len("/asset/"):])).name
            return f if f.is_file() else None

        def do_HEAD(self):
            if foreign("HEAD", self.headers):
                return self._send(403, b"", "text/plain")
            f = self._asset() if self.route.startswith("/asset/") else None
            if not f:
                return self._send(404, b"", "text/plain")
            self._send_file(f, head=True)

        @property
        def route(self) -> str:
            """The path without its query string. `/?x=1` is the page, not a 404."""
            return urlsplit(self.path).path

        def do_GET(self):
            if foreign("GET", self.headers):
                return self._send(403, b"forbidden", "text/plain")
            if self.route in ("/", "/index.html"):
                nonce = secrets.token_urlsafe(16)
                page = (app.replace(BOOT, "window.__SESSION__=%s;window.__ITEMS__=%s;%s"
                                    % (json.dumps(sess.name), json.dumps(items), test_js), 1)
                           .replace("__NONCE__", nonce))
                return self._send(200, page.encode(),
                                  extra=(("Content-Security-Policy", CSP.format(nonce=nonce)),))
            if self.route == "/draft":
                f = sess / "draft.json"
                return self._send(200, f.read_bytes() if f.exists() else b"{}",
                                  "application/json")
            if self.route.startswith("/vendor/"):
                name = Path(unquote(self.route[len("/vendor/"):])).name
                if name not in VENDOR_FILES or not (VENDOR / name).exists():
                    return self._send(404, b"not found", "text/plain")
                # A year, because the name carries no hash and the folder changes only when
                # somebody runs the update procedure in assets/vendor/pdfjs/README.md.
                return self._send(200, (VENDOR / name).read_bytes(), content_type(VENDOR / name),
                                  extra=(("Cache-Control", "max-age=31536000, immutable"),))
            if self.route.startswith("/asset/"):
                f = self._asset()
                if not f:
                    return self._send(404, b"not found", "text/plain")
                return self._send_file(f)
            self._send(404, b"not found", "text/plain")

        def do_POST(self):
            if foreign("POST", self.headers):
                return self._send(403, b"forbidden", "text/plain")
            n = int(self.headers.get("Content-Length", 0))
            raw = self.rfile.read(n) or b"{}"
            with post_lock:
                self._post(raw)

        def _post(self, raw: bytes):
            # The draft is written on every change and is the only reason an interrupted review
            # costs nothing: a crashed tab, a closed window, a reload mid-sentence. It is deliberately
            # dumb (last write wins, whole state, no merge) because the alternative is a merge bug
            # that loses exactly the note somebody cared enough to retype.
            if self.route == "/draft":
                # After Send the round is over. A late save, from this page or from a second tab on
                # the same review, would hand the notes of this round to the next one on these files.
                if sent.is_set():
                    return self._send(409, b'{"ok":false}', "application/json")
                # Whole or not at all: a GET of the draft can now run while this writes.
                part = sess / "draft.json.part"
                part.write_bytes(raw)
                part.replace(sess / "draft.json")
                return self._send(200, b'{"ok":true}', "application/json")
            if self.route == "/close":
                # After Send the page reports how closing its own tab went. A refused tab is closed
                # from outside where that is allowed, and the server stops either way.
                if not sent.is_set():
                    return self._send(409, b'{"closed":0}', "application/json")
                try:
                    body = json.loads(raw)
                except ValueError:
                    body = None
                refused = isinstance(body, dict) and body.get("refused") is True
                base = f"http://127.0.0.1:{self.server.server_address[1]}/"
                closed = close_tab((base, base + "index.html")) if refused else 0
                stop(0.3)                       # before the reply, which can raise
                return self._send(200, json.dumps({"closed": closed}).encode(), "application/json")
            if self.route != "/send":
                return self._send(404, b"not found", "text/plain")
            if sent.is_set():                   # a second tab on a review that is already sent
                return self._send(409, b'{"ok":false}', "application/json")
            write_outputs(sess, json.loads(raw))
            sent.set()
            (sess / "draft.json").unlink(missing_ok=True)
            hook = sess / "on_send"
            try:
                # Split like a shell line, run WITHOUT a shell: no pipe, no &&, no $VAR, so nothing
                # in the command can be read as code.
                cmd = shlex.split(hook.read_text()) if hook.exists() else []
                if cmd:
                    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     start_new_session=True)
            except (OSError, ValueError):
                pass
            # The page reports to /close about a second after this reply, and the server stops right
            # after that. This timer is for a page that never reports. It and the hook come before
            # the reply, because a reply to a tab that is already gone raises.
            stop(3)
            self._send(200, b'{"ok":true}', "application/json")

    # Port 0 means "any free port", which is right on the machine you are sitting at. A FIXED port
    # is for the case where something outside this tool has to find the page: a forward from a
    # laptop to a workstation, a container mapping, a bookmark. It is never a wider bind: the
    # address stays 127.0.0.1 either way, and a review page holds a draft nobody else should read.
    #
    # A taken port is an ERROR rather than a silent fallback to a random one. The whole value of
    # asking for a port is that the answer is predictable, and a fallback would hand back a working
    # page at an address the thing waiting for it is not watching.
    class Server(socketserver.ThreadingMixIn, socketserver.TCPServer):
        # A finished round leaves its connections in TIME_WAIT, and without SO_REUSEADDR the next
        # round on a FIXED port failed with "Address already in use" although nothing listened
        # (measured 2026-09-30). A port that still has a live listener keeps refusing.
        allow_reuse_address = True
        # One thread per request. A browser holds a video download open and stops reading once
        # its buffer is full, and on a server that answers one request at a time that stalled
        # write held back every other request, the draft save and Send among them. Daemon
        # threads that nobody joins, so a stalled download cannot hold up the exit either.
        daemon_threads = True
        block_on_close = False

    try:
        httpd = Server(("127.0.0.1", port), Handler)
    except OSError as e:
        # stderr here goes to server.log, which nobody is watching, so the reason is written where
        # the parent will look for it.
        (sess / "error").write_text(
            f"cannot listen on 127.0.0.1:{port} ({e.strerror}). "
            f"Free that port, or omit --port to take any free one.")
        sys.exit(1)
    with httpd:
        (sess / "url").write_text(f"http://127.0.0.1:{httpd.server_address[1]}/")
        (sess / "server.pid").write_text(str(os.getpid()))
        if ready:
            ready(httpd)        # the selftest runs this server in a thread and has to stop it
        httpd.serve_forever()


# --------------------------------------------------------------------------- commands
def review_port(args) -> int:
    """The port to listen on: the flag, else REVIEW_PORT, else 0 for any free one."""
    if getattr(args, "port", None):
        return int(args.port)
    env = os.environ.get("REVIEW_PORT", "").strip()
    return int(env) if env.isdigit() else 0


def cmd_open(args) -> int:
    paths = [Path(p).expanduser() for p in args.files]
    sess = ROOT / session_id(paths)
    sess.mkdir(parents=True, exist_ok=True)
    for stale in ("batch.json", "url", "server.pid", "receipt.json", "error"):
        (sess / stale).unlink(missing_ok=True)
    # draft.json is deliberately NOT cleared: reopening the same files restores what was typed.
    (sess / "on_send").write_text(getattr(args, "on_send", "") or "")
    items = stage_inputs(paths, sess)

    if os.fork() > 0:
        for _ in range(100):
            if (sess / "url").exists():
                break
            time.sleep(0.05)
        kinds = ", ".join(f"{sum(1 for i in items if i['kind'] == k)} {k}"
                          for k in ("text", "media", "video") if any(i["kind"] == k for i in items))
        # A SERVER THAT NEVER CAME UP MUST NOT LOOK LIKE ONE THAT DID. The first version printed
        # "(not started)", followed it with the poll instructions, and exited 0, so a caller that
        # checked the exit code saw a healthy open and waited forever for a page that was never
        # served. The child writes the reason and this reports it.
        if not (sess / "url").exists():
            why = (sess / "error").read_text().strip() if (sess / "error").exists() else \
                  "the server did not start; see " + str(sess / "server.log")
            print(f"Staged {kinds} as session {sess.name}", file=sys.stderr)
            print(why, file=sys.stderr)
            return 1
        url = (sess / "url").read_text().strip()
        print(f"Reviewing {kinds} as session {sess.name}")
        print(url)
        if shutil.which("clip-put"):               # the URL belongs on his clipboard, not only here
            subprocess.run(["clip-put"], input=url, text=True, capture_output=True)
        print("\nWaiting for feedback? Run this in the background; it exits when he hits Send:")
        print(f"  review poll --session {sess.name}")
        if not args.no_browser:
            webbrowser.open(url)
        return 0

    os.setsid()
    log = os.open(str(sess / "server.log"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    devnull = os.open(os.devnull, os.O_RDONLY)
    os.dup2(devnull, 0); os.dup2(log, 1); os.dup2(log, 2)
    serve(sess, items, port=review_port(args))
    return 0


def cmd_poll(args) -> int:
    sess = resolve_session(args.session)
    batch = sess / "batch.json"
    deadline = time.time() + args.timeout if args.timeout else None
    while True:
        if batch.exists():
            print(json.dumps(json.loads(batch.read_text()), indent=2, ensure_ascii=False))
            if args.ack:
                batch.unlink()
            return 0
        pid_file = sess / "server.pid"
        if pid_file.exists():
            try:
                os.kill(int(pid_file.read_text()), 0)
            except (ProcessLookupError, ValueError):
                print(json.dumps({"status": "closed", "reason": "review window was closed"}))
                return 0
        if deadline and time.time() > deadline:
            print(json.dumps({"status": "timeout"}))
            return 0
        time.sleep(0.5)


def cmd_status(args) -> int:
    sess = resolve_session(args.session)
    print(json.dumps({"status": "feedback-waiting" if (sess / "batch.json").exists() else "empty",
                      "session": sess.name,
                      "url": (sess / "url").read_text().strip() if (sess / "url").exists() else None}))
    return 0


def cmd_close(args) -> int:
    sess = resolve_session(args.session)
    pid_file = sess / "server.pid"
    if pid_file.exists():
        try:
            os.kill(int(pid_file.read_text()), signal.SIGTERM)
        except (ProcessLookupError, ValueError):
            pass
        pid_file.unlink(missing_ok=True)
    print(json.dumps({"status": "closed", "session": sess.name}))
    return 0


def make_fixture_pdf(path: Path, pages: list[list[tuple[int, int, int, str]]]) -> None:
    """A real PDF, written here, so the tests never depend on a file somebody has to supply.

    Helvetica text at positions this function chose, which is the ground truth the browser test
    reads back out of the text layer. Uncompressed and classic cross-reference table: the point is
    a file every parser accepts, not a small one.
    """
    def esc(t: str) -> str:
        return t.replace("\\", r"\\").replace("(", r"\(").replace(")", r"\)")

    objs: dict[int, bytes] = {}
    n = len(pages)
    page_ids = [4 + 2 * i for i in range(n)]
    objs[1] = b"<</Type/Catalog/Pages 2 0 R>>"
    kids = " ".join(f"{i} 0 R" for i in page_ids)
    objs[2] = f"<</Type/Pages/Kids[{kids}]/Count {n}>>".encode()
    objs[3] = b"<</Type/Font/Subtype/Type1/BaseFont/Helvetica/Encoding/WinAnsiEncoding>>"
    for i, lines in enumerate(pages):
        pid, cid = page_ids[i], page_ids[i] + 1
        body = "\n".join(f"BT /F1 {size} Tf 1 0 0 1 {x} {y} Tm ({esc(text)}) Tj ET"
                         for x, y, size, text in lines).encode("latin-1", "replace")
        objs[pid] = (f"<</Type/Page/Parent 2 0 R/MediaBox[0 0 595 842]"
                     f"/Resources<</Font<</F1 3 0 R>>>>/Contents {cid} 0 R>>").encode()
        objs[cid] = b"<</Length %d>>stream\n%s\nendstream" % (len(body), body)

    out = bytearray(b"%PDF-1.4\n%\xe2\xe3\xcf\xd3\n")
    offsets = {}
    for num in sorted(objs):
        offsets[num] = len(out)
        out += b"%d 0 obj\n%s\nendobj\n" % (num, objs[num])
    start = len(out)
    top = max(objs) + 1
    out += b"xref\n0 %d\n0000000000 65535 f \n" % top
    for num in range(1, top):
        out += b"%010d 00000 n \n" % offsets.get(num, 0)
    out += b"trailer\n<</Size %d/Root 1 0 R>>\nstartxref\n%d\n%%%%EOF\n" % (top, start)
    path.write_bytes(bytes(out))


# One pixel, transparent. Enough to stand in for a staged image: nothing here decodes it.
PNG_1PX = ("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5"
           "ErkJggg==")


def _write_tiny_pptx(path: Path) -> None:
    """Two slides, notes on the first only: just the parts pptx_notes reads."""
    rel = ('<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
           '{}</Relationships>')
    one = '<Relationship Id="{}" Type="x" Target="{}"/>'
    p = 'xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"'
    a = 'xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"'
    r = 'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"'
    para = "<a:p><a:r><a:t>{}</a:t></a:r></a:p>"
    with zipfile.ZipFile(path, "w") as z:
        z.writestr("ppt/presentation.xml", f'<p:presentation {p} {r}><p:sldIdLst>'
                   '<p:sldId id="256" r:id="rId2"/><p:sldId id="257" r:id="rId3"/>'
                   "</p:sldIdLst></p:presentation>")
        z.writestr("ppt/_rels/presentation.xml.rels",
                   rel.format(one.format("rId2", "slides/slide1.xml")
                              + one.format("rId3", "slides/slide2.xml")))
        z.writestr("ppt/slides/slide1.xml", f"<p:sld {p}/>")
        z.writestr("ppt/slides/slide2.xml", f"<p:sld {p}/>")
        z.writestr("ppt/slides/_rels/slide1.xml.rels",
                   rel.format(one.format("rId9", "../notesSlides/notesSlide1.xml")))
        z.writestr("ppt/notesSlides/notesSlide1.xml",
                   f'<p:notes {p} {a}><p:cSld><p:spTree>'
                   '<p:sp><p:nvSpPr><p:nvPr><p:ph type="sldNum"/></p:nvPr></p:nvSpPr>'
                   f'<p:txBody>{para.format("3")}</p:txBody></p:sp>'
                   '<p:sp><p:nvSpPr><p:nvPr><p:ph type="body"/></p:nvPr></p:nvSpPr><p:txBody>'
                   f'{para.format("Say the why.")}{para.format("Then the ask.")}</p:txBody></p:sp>'
                   "</p:spTree></p:cSld></p:notes>")


def _write_tiny_docx(path: Path) -> None:
    """A minimal valid docx with one paragraph, readable by zipfile and Office."""
    content_types = ('<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
                     '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
                     '<Default Extension="xml" ContentType="application/xml"/>'
                     '<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>'
                     '</Types>')
    rels = ('<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
            '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>'
            '</Relationships>')
    doc = ('<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">'
           '<w:body><w:p><w:r><w:t>Fixture document</w:t></w:r></w:p></w:body></w:document>')
    with zipfile.ZipFile(path, "w") as z:
        z.writestr("[Content_Types].xml", content_types)
        z.writestr("_rels/.rels", rels)
        z.writestr("word/document.xml", doc)


FIXTURE_PAGES = [
    [(72, 760, 20, "Fixture statement"),
     (72, 700, 12, "Interest 1.234,56 EUR for the period"),
     (72, 670, 12, "Section 1: placeholder text on page one"),
     (72, 640, 12, "The same placeholder appears twice in this document"),
     (72, 120, 6, "Footnote at six point, which a crop has to keep legible")],
    [(72, 760, 20, "Second page"),
     (72, 700, 12, "Section 2: another line to select")],
    [(72, 760, 20, "Third page"),
     (72, 700, 12, "Nothing of interest here")],
]
FIXTURE_DRAFT = ("# Fixture draft\n\nA paragraph that says placeholder once and then says "
                 "placeholder a second time.\n\n## Second heading\n\nMore text.\n\n"
                 "Plain **bold**er, *em*, done.\n\n- alpha\n- beta\n")
CHROME_CANDIDATES = (
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Chromium.app/Contents/MacOS/Chromium",
    "google-chrome", "google-chrome-stable", "chromium", "chromium-browser",
)


def find_chrome() -> str | None:
    for c in CHROME_CANDIDATES:
        if Path(c).exists():
            return c
        found = shutil.which(c)
        if found:
            return found
    return None


def vendor_mismatches() -> list[str]:
    """Every vendored file that is not byte for byte what SHA256SUMS records.

    A formatter, a half-finished update or a tampered copy all land here, and the page never gets
    to load any of them: the test fails first.
    """
    sums = VENDOR / "SHA256SUMS"
    if not sums.exists():
        return ["SHA256SUMS is missing"]
    bad = []
    for line in sums.read_text().splitlines():
        want, _, name = line.partition("  ")
        f = VENDOR / name.strip()
        if not f.exists():
            bad.append(f"{name}: missing")
        elif hashlib.sha256(f.read_bytes()).hexdigest() != want:
            bad.append(f"{name}: changed")
    return bad


def cmd_selftest(args) -> int:
    failures: list[str] = []

    def check(name: str, got, want=True) -> None:
        if got == want:
            print(f"ok   {name}")
            return
        failures.append(name)
        print(f"FAIL {name}\n       got  {got!r}\n       want {want!r}")

    md = render_markdown("# H\n\ntext **b** and `c`\n\n- one\n- two\n\n> quote\n")
    check("markdown subset", all(x in md for x in ("<h1>H</h1>", "<strong>b</strong>",
                                                   "<li>one</li>", "<blockquote>quote</blockquote>")))
    body = html_body("<html><body><p>keep</p><script>drop()</script></body></html>")
    check("html body keeps content and drops script", "keep" in body and "drop" not in body)
    tbl = render_markdown("| a | b |\n|---|---|\n| 1 | 2 |\n")
    check("markdown table", "<th>a</th>" in tbl and "<td>2</td>" in tbl)
    para_list = render_markdown("Intro text.\n- item 1\n- item 2\n---\nOutro.")
    check("paragraph before list and hr separated",
          "<p>Intro text.</p>\n<ul><li>item 1</li><li>item 2</li></ul>\n<hr>\n<p>Outro.</p>" in para_list)
    code_star = render_markdown("Run `ls *` or `cat *` now.")
    check("asterisks inside inline code not parsed as emphasis",
          "<p>Run <code>ls *</code> or <code>cat *</code> now.</p>" == code_star)
    check("non-block line starting with block characters renders as paragraph",
          (render_markdown(" | not a table"), render_markdown("#hashtag"), render_markdown("|x")),
          ('<p> | not a table</p>', '<p>#hashtag</p>', '<p>|x</p>'))

    ok = {"Host": "127.0.0.1:8000"}
    origin_cases = (
            ("GET", ok, False), ("POST", ok, False),                  # curl sends no browser headers
            ("POST", {**ok, "Sec-Fetch-Site": "same-origin"}, False),
            ("POST", {**ok, "Sec-Fetch-Site": "cross-site"}, True),
            ("POST", {**ok, "Sec-Fetch-Site": "same-site"}, True),   # a page on another local port
            ("POST", {**ok, "Origin": "http://localhost:8000"}, False),
            ("POST", {**ok, "Origin": "https://example.com"}, True),
            ("GET", {"Host": "rebound.example.com:8000"}, True),     # DNS rebinding
            ("GET", {"Host": "127.0.0.1@example.com"}, True), ("GET", {}, True))
    check("request origin check",
          [foreign(m, h) for m, h, _ in origin_cases], [w for _, _, w in origin_cases])

    with tempfile.TemporaryDirectory() as tmp:
        deck = Path(tmp) / "deck.pptx"
        _write_tiny_pptx(deck)
        check("pptx speaker notes", pptx_notes(deck), ["Say the why.\nThen the ask.", ""])
        check("a slide without notes says so",
              "<h3>Slide 2</h3><p><em>no speaker notes</em></p>" in notes_html(pptx_notes(deck)))

    # ---- soffice conversions and stub modes (.pptx and .docx) --------------------------
    with tempfile.TemporaryDirectory() as tmp_soffice:
        tmp_s = Path(tmp_soffice)
        sess = tmp_s / "sess"
        sess.mkdir()
        deck = tmp_s / "test_deck.pptx"
        _write_tiny_pptx(deck)
        doc = tmp_s / "test_doc.docx"
        _write_tiny_docx(doc)
        encrypted_doc = tmp_s / "encrypted.docx"
        encrypted_doc.write_bytes(b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1" + b"EncryptedPackage")
        dummy_card = tmp_s / "fallback.png"
        dummy_card.write_bytes(base64.b64decode(PNG_1PX))

        # Encrypted docx is skipped before soffice runs
        err = io.StringIO()
        with contextlib.redirect_stderr(err):
            enc_items = stage_inputs([encrypted_doc, dummy_card], sess)
        check("encrypted docx is skipped before soffice runs",
              [i["name"] for i in enc_items], ["fallback.png"])
        check("encrypted docx emits skipping warning",
              "password-protected Word document is not a zip" in err.getvalue())

        # Encrypted pptx is skipped before soffice runs
        encrypted_deck = tmp_s / "encrypted.pptx"
        encrypted_deck.write_bytes(b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1" + b"EncryptedPackage")
        err = io.StringIO()
        with contextlib.redirect_stderr(err):
            enc_deck_items = stage_inputs([encrypted_deck, dummy_card], sess)
        check("encrypted pptx is skipped before soffice runs",
              [i["name"] for i in enc_deck_items], ["fallback.png"])
        check("encrypted pptx emits skipping warning",
              "password-protected PowerPoint deck is not a zip" in err.getvalue())

        # Setup stub soffice script
        mode_file = tmp_s / "soffice_mode"
        stub_soffice = tmp_s / "stub_soffice"
        stub_soffice.write_text(f"""#!/usr/bin/env python3
import sys
from pathlib import Path

mode = Path({repr(str(mode_file))}).read_text().strip()
if mode == "write":
    out = Path(sys.argv[sys.argv.index("--outdir") + 1])
    src = Path(sys.argv[-1])
    (out / f"{{src.stem}}.pdf").write_bytes(b"%PDF-1.4 minimal")
    sys.exit(0)
elif mode == "no_pdf":
    sys.exit(0)
elif mode == "fail":
    sys.exit(1)
""")
        stub_soffice.chmod(0o755)

        orig_which = shutil.which

        # Mode 1: missing
        mode_file.write_text("missing")
        shutil.which = lambda cmd: None if cmd in ("soffice", "libreoffice") else orig_which(cmd)
        try:
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                missing_items = stage_inputs([deck, doc, dummy_card], sess)
            check("soffice missing skips pptx and docx",
                  [i["name"] for i in missing_items], ["fallback.png"])
            check("soffice missing emits skipping warning",
                  "needs LibreOffice (soffice) to render" in err.getvalue())
        finally:
            shutil.which = orig_which

        # Mode 3: exits 0 without a PDF
        mode_file.write_text("no_pdf")
        shutil.which = lambda cmd: str(stub_soffice) if cmd in ("soffice", "libreoffice") else orig_which(cmd)
        try:
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                no_pdf_items = stage_inputs([deck, doc, dummy_card], sess)
            check("soffice exits 0 without a PDF skips items",
                  [i["name"] for i in no_pdf_items], ["fallback.png"])
            check("soffice exits 0 without PDF emits skipping warning",
                  "LibreOffice wrote no PDF for it" in err.getvalue())
        finally:
            shutil.which = orig_which

        # Mode 4: exits non-zero
        mode_file.write_text("fail")
        shutil.which = lambda cmd: str(stub_soffice) if cmd in ("soffice", "libreoffice") else orig_which(cmd)
        try:
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                fail_items = stage_inputs([deck, doc, dummy_card], sess)
            check("soffice exits non-zero skips items",
                  [i["name"] for i in fail_items], ["fallback.png"])
            check("soffice exits non-zero emits skipping warning",
                  "LibreOffice conversion failed" in err.getvalue())
        finally:
            shutil.which = orig_which

        # Mode 2: writes the PDF (and assert item shapes for both .pptx and .docx)
        mode_file.write_text("write")
        shutil.which = lambda cmd: str(stub_soffice) if cmd in ("soffice", "libreoffice") else orig_which(cmd)
        try:
            pptx_staged = stage_inputs([deck], sess)
            check("pptx item count is two (deck + notes)", len(pptx_staged), 2)
            check("pptx deck item shape",
                  (pptx_staged[0]["kind"], pptx_staged[0]["format"], pptx_staged[0]["page_label"], pptx_staged[0].get("deck")),
                  ("media", "pdf", "slide", True))
            check("pptx notes item shape",
                  (pptx_staged[1]["kind"], pptx_staged[1]["format"], pptx_staged[1].get("notes_of")),
                  ("text", "html", str(deck.resolve())))
            check("pptx deck source_sha256 recorded at staging", bool(pptx_staged[0].get("source_sha256")), True)
            check("pptx notes source_sha256 recorded at staging", bool(pptx_staged[1].get("source_sha256")), True)

            # Modify pptx on disk and assert source snapshot warning and receipt certification
            h_deck_staged = pptx_staged[0].get("source_sha256")
            deck.write_bytes(b"modified deck content")
            stderr_deck = io.StringIO()
            with contextlib.redirect_stderr(stderr_deck):
                write_outputs(sess, {"pages": [
                    {"kind": "media", "item": pptx_staged[0]["id"], "page": 1, "pages": 1,
                     "name": "test_deck.pptx, slide 1", "overview_png": "data:image/png;base64," + PNG_1PX,
                     "crops": [], "comments": []}
                ]})
            receipt_deck = json.loads((sess / "receipt.json").read_text())
            check("pptx source snapshot warns on Send when deck changed",
                  "warning: test_deck.pptx changed on disk since review opened" in stderr_deck.getvalue(), True)
            check("receipt certifies staged pptx hash, not modified bytes",
                  receipt_deck["sha256"].get(str(deck.resolve())), h_deck_staged)

            docx_staged = stage_inputs([doc], sess)
            check("docx item count is one (pages, no notes)", len(docx_staged), 1)
            check("docx item shape",
                  (docx_staged[0]["kind"], docx_staged[0]["format"], docx_staged[0]["page_label"], docx_staged[0].get("deck")),
                  ("media", "pdf", "page", None))

            # Source snapshot: hash at staging and warn on Send if changed since
            h_staged = docx_staged[0].get("source_sha256")
            check("docx source_sha256 recorded at staging", bool(h_staged), True)

            # Modify docx on disk
            doc.write_bytes(b"modified docx content")
            stderr_buf = io.StringIO()
            with contextlib.redirect_stderr(stderr_buf):
                batch_res = write_outputs(sess, {"pages": [
                    {"kind": "media", "item": docx_staged[0]["id"], "page": 1, "pages": 1,
                     "name": "test_doc.docx, page 1", "overview_png": "data:image/png;base64," + PNG_1PX,
                     "crops": [], "comments": []}
                ]})
            receipt_data = json.loads((sess / "receipt.json").read_text())
            check("source snapshot warns on Send when file changed",
                  "warning: test_doc.docx changed on disk since review opened" in stderr_buf.getvalue(), True)
            check("receipt certifies staged hash, not modified bytes",
                  receipt_data["sha256"].get(str(doc.resolve())), h_staged)
        finally:
            shutil.which = orig_which

    # ---- the vendored parser -------------------------------------------------------------
    check("vendored pdf.js matches its checksums", vendor_mismatches(), [])
    page = APP.read_text()
    check("the page has the injection point and the nonce slot",
          BOOT in page and "__NONCE__" in page)
    # The page may reach nothing but this server. A URL with a host in it would be a third-party
    # request from a page that holds private documents.
    remote = [u for u in re.findall(r'(?:src|href|from|import)\s*=?\s*["\'](//[^"\']+|https?://[^"\']+)',
                                    page)]
    check("the page loads nothing from another host", remote, [])

    # ---- staging: the two defects of 2026-10-02 ------------------------------------------
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        sess = tmp / "sess"
        sess.mkdir()
        doc = tmp / "doc.pdf"
        make_fixture_pdf(doc, FIXTURE_PAGES)                       # three pages
        items = stage_inputs([doc], sess)
        check("a PDF is one item, not one per page", len(items), 1)
        check("a PDF is served as a PDF", items[0].get("format"), "pdf")
        check("the staged PDF is the file itself",
              (sess / "assets" / Path(items[0]["url"]).name).read_bytes(), doc.read_bytes())
        first_assets = sorted(p.name for p in (sess / "assets").iterdir())

        # REGRESSION, stale pages: the same path, now two pages. The old renderer left the third
        # page of the previous round in the folder and showed it again.
        make_fixture_pdf(doc, FIXTURE_PAGES[:2])
        items = stage_inputs([doc], sess)
        check("a PDF that shrank leaves nothing behind",
              sorted(p.name for p in (sess / "assets").iterdir()), first_assets)
        check("the staged PDF is the CURRENT file",
              (sess / "assets" / Path(items[0]["url"]).name).read_bytes(), doc.read_bytes())

        # REGRESSION, glob over-match: doc-summary.png was collected as a page of doc.pdf,
        # because the old code globbed <stem>*.png.
        summary = tmp / "doc-summary.png"
        summary.write_bytes(base64.b64decode(PNG_1PX))
        items = stage_inputs([summary, doc], sess)
        check("an image whose name starts with the PDF's is not a page of it",
              [(i["name"], i.get("format"), Path(i["url"]).suffix) for i in items],
              [("doc-summary.png", "image", ".png"), ("doc.pdf", "pdf", ".pdf")])
        check("no asset from an earlier round survives",
              sorted(p.name for p in (sess / "assets").iterdir()),
              ["d1_doc_summary.png", "d2_doc.pdf"])

        # Two files with one name in different folders used to write one asset and share one id.
        (tmp / "a").mkdir(); (tmp / "b").mkdir()
        for d in ("a", "b"):
            (tmp / d / "same.png").write_bytes(base64.b64decode(PNG_1PX))
        items = stage_inputs([tmp / "a" / "same.png", tmp / "b" / "same.png"], sess)
        check("two files with one name stay two documents",
              len({i["id"] for i in items}) == 2 and len({i["url"] for i in items}) == 2)

    # ---- the batch -----------------------------------------------------------------------
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        sess = tmp / "sess"
        sess.mkdir()
        card = tmp / "card.png"
        card.write_bytes(base64.b64decode(PNG_1PX))
        draft = tmp / "draft.md"
        draft.write_text(FIXTURE_DRAFT)
        pdf = tmp / "statement.pdf"
        make_fixture_pdf(pdf, FIXTURE_PAGES)
        items = stage_inputs([card, draft, pdf], sess)
        data = "data:image/png;base64," + PNG_1PX
        batch = write_outputs(sess, {"pages": [
            {"kind": "media", "item": "d1", "name": "card.png", "overview_png": data,
             "crops": [{"mark": 1, "png": data}],
             "comments": [{"id": "m_1", "number": 1, "tool": "ellipse", "note": "head smaller",
                           "box": {"x": 0.30, "y": 0.05, "w": 0.40, "h": 0.17}}]},
            {"kind": "text", "item": "d2", "name": "draft.md",
             "comments": [{"id": "c_2", "number": 2, "quote": "placeholder",
                           "anchor": {"prefix": "says ", "suffix": " a second"},
                           "block": "d2#1", "note": "cut this"},
                          {"id": "m_4", "number": 4, "tool": "ellipse", "quote": "Second heading",
                           "blocks": ["d2#2"], "box": {"x": 0.1, "y": 0.4, "w": 0.3, "h": 0.05},
                           "note": "rename"},
                          {"id": "c_5", "number": 5, "quote": "says\nSecond",
                           "anchor": {"prefix": "A paragraph that ", "quote": "says\nSecond",
                                      "suffix": " heading"},
                           "block": "d2#1", "blocks": ["d2#1", "d2#2"],
                           "parts": [{"block": "d2#1", "quote": "says"},
                                     {"block": "d2#2", "quote": "Second"}], "note": "both"},
                          {"id": "c_6", "number": 6, "tool": "<script>", "quote": "x",
                           "anchor": {}, "blocks": [7, "d2#3"], "note": "forged"}],
             "edits": [{"block": "d2#0", "label": "h1", "before": "A", "after": "B"}]},
            {"kind": "media", "item": "d3", "page": 2, "pages": 3, "name": "statement.pdf, page 2",
             "overview_png": data, "crops": [{"mark": 3, "png": data}],
             "comments": [{"id": "m_3", "number": 3, "tool": "text", "note": "this total is wrong",
                           "quote": "1.234,56", "anchor": {"prefix": "Interest ", "suffix": " EUR"},
                           "rects": [{"x": 0.19, "y": 0.22, "w": 0.09, "h": 0.02}],
                           "box": {"x": 0.19, "y": 0.22, "w": 0.09, "h": 0.02}}]},
        ], "overall_note": "the rest is fine"})

        image_page, text_page, pdf_page = batch["pages"]
        # Backward compatibility is the promise: every field a reader used still carries the same
        # name, type and meaning, and `kind` is still only "media" or "text".
        check("batch keeps the documented top level",
              sorted(batch), ["overall_note", "pages", "received_at", "session", "status"])
        check("batch kinds are unchanged", sorted({p["kind"] for p in batch["pages"]}),
              ["media", "text"])
        check("an image page keeps its fields", sorted(image_page),
              ["kind", "marks", "name", "overview", "source"])
        check("an image mark keeps its fields", sorted(image_page["marks"][0]),
              ["box", "crop", "id", "note", "number", "tool"])
        check("a text page keeps its fields", sorted(text_page),
              ["comments", "edits", "edits_saved", "kind", "name", "source"])
        check("a plain text comment gains no field", sorted(text_page["comments"][0]),
              ["anchor", "block", "id", "note", "number", "quote"])
        drawn, spanned, forged = text_page["comments"][1:]
        check("a shape on a draft carries its tool and box, and an empty anchor", sorted(drawn),
              ["anchor", "block", "box", "id", "note", "number", "quote", "tool"])
        check("so a reader of anchor['prefix'] on every comment keeps working",
              drawn["anchor"], {"prefix": "", "suffix": ""})
        check("a shape on one block names it in `block` only",
              [drawn["tool"], drawn["block"]], ["ellipse", "d2#2"])
        check("a selection over two blocks gains only `blocks` and `parts`", sorted(spanned),
              ["anchor", "block", "blocks", "id", "note", "number", "parts", "quote"])
        check("its parts keep each block's own text", spanned["parts"],
              [{"block": "d2#1", "quote": "says"}, {"block": "d2#2", "quote": "Second"}])
        check("a selection over two blocks lists both", spanned["blocks"], ["d2#1", "d2#2"])
        check("a tool or a block the page cannot produce is not carried",
              [forged.get("tool"), forged["block"], "blocks" in forged], [None, "d2#3", False])
        check("marks.md names the tool of a shape on a draft",
              '4. [ellipse] "Second heading"' in (sess / "marks.md").read_text())
        check("source points at the original file", image_page["source"], str(card.resolve()))
        check("the crop was written", Path(image_page["marks"][0]["crop"]).exists())
        # Additions, and only additions, on a PDF page.
        check("a PDF page says which document and which page",
              [pdf_page["document"], pdf_page["page"], pdf_page["pages"], pdf_page["kind"]],
              ["statement.pdf", 2, 3, "media"])
        check("a PDF page is named by its label", pdf_page["name"], "statement.pdf, page 2")
        check("a selection mark carries the words that were selected",
              sorted(pdf_page["marks"][0]),
              ["anchor", "box", "crop", "id", "note", "number", "quote", "rects", "tool"])
        check("the overview of a PDF page is named by document and page",
              Path(pdf_page["overview"]).name, "overview_d3_statement_p02.png")
        check("marks.md names the page in full",
              "## statement.pdf, page 2 of 3" in (sess / "marks.md").read_text())
        check("marks.md quotes the selection",
              '"1.234,56"' in (sess / "marks.md").read_text())
        check("the receipt lists every reviewed file",
              len(json.loads((sess / "receipt.json").read_text())["sha256"]), 3)
        check("card source_sha256 recorded at staging", bool(items[0].get("source_sha256")), True)
        check("draft source_sha256 recorded at staging", bool(items[1].get("source_sha256")), True)
        check("pdf source_sha256 recorded at staging", bool(items[2].get("source_sha256")), True)

        # Modify draft.md and statement.pdf on disk, verify warning on Send and receipt certification
        h_draft_staged = items[1]["source_sha256"]
        h_pdf_staged = items[2]["source_sha256"]
        draft.write_text("modified draft markdown content")
        pdf.write_bytes(b"%PDF-1.4 modified statement bytes")
        stderr_mod = io.StringIO()
        with contextlib.redirect_stderr(stderr_mod):
            write_outputs(sess, {"pages": [
                {"kind": "text", "item": "d2", "name": "draft.md", "comments": [], "edits": []},
                {"kind": "media", "item": "d3", "page": 1, "pages": 3, "name": "statement.pdf, page 1",
                 "overview_png": data, "crops": [], "comments": []}
            ]})
        err_text = stderr_mod.getvalue()
        receipt_mod = json.loads((sess / "receipt.json").read_text())
        check("source snapshot warns when markdown changed on disk",
              "warning: draft.md changed on disk since review opened" in err_text, True)
        check("source snapshot warns when pdf changed on disk",
              "warning: statement.pdf changed on disk since review opened" in err_text, True)
        check("receipt certifies staged markdown hash, not modified bytes",
              receipt_mod["sha256"].get(str(draft.resolve())), h_draft_staged)
        check("receipt certifies staged pdf hash, not modified bytes",
              receipt_mod["sha256"].get(str(pdf.resolve())), h_pdf_staged)
        make_fixture_pdf(pdf, FIXTURE_PAGES)

        # A deck page reports the slide it came from, which is how an edit finds its way back.
        deck_items = [dict(items[2], deck=True, page_label="slide")]
        (sess / "items.json").write_text(json.dumps(deck_items))
        deck_batch = write_outputs(sess, {"pages": [
            {"kind": "media", "item": "d3", "page": 2, "pages": 3, "name": "deck, slide 2",
             "overview_png": data, "crops": [], "comments": []}]})
        check("a deck page keeps its slide number", deck_batch["pages"][0].get("slide"), 2)

    # ---- the server ----------------------------------------------------------------------
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        sess = tmp / "sess"
        sess.mkdir()
        pdf = tmp / "statement.pdf"
        make_fixture_pdf(pdf, FIXTURE_PAGES)
        items = stage_inputs([pdf], sess)
        with serving(sess, items) as base:
            page, headers = fetch(base)
            csp = headers.get("Content-Security-Policy", "")
            nonce = re.search(r"'nonce-([\w-]+)'", csp)
            check("the page carries a Content-Security-Policy", csp.startswith("default-src 'none'"))
            check("the policy allows no inline script but the two it stamps",
                  "'unsafe-inline'" not in csp.split("style-src")[0])
            check("the nonce in the policy is the nonce in the page",
                  bool(nonce) and page.count(f'nonce="{nonce.group(1)}"'), 2)
            check("the session globals were injected", "window.__ITEMS__=[" in page)
            check("no injection point is left in the served page", BOOT in page, False)
            body, headers = fetch(base + "asset/" + Path(items[0]["url"]).name)
            check("a PDF is served as a PDF", headers.get("Content-Type"), "application/pdf")
            check("nothing may be sniffed", headers.get("X-Content-Type-Options"), "nosniff")
            _, headers = fetch(base + "vendor/pdf.min.mjs")
            check("the vendored module is served as JavaScript",
                  headers.get("Content-Type"), "text/javascript; charset=utf-8")
            check("the vendor folder serves nothing else",
                  fetch(base + "vendor/SHA256SUMS")[1].get("status"), 404)
            check("the vendor folder cannot be walked out of",
                  fetch(base + "vendor/..%2f..%2fSKILL.md")[1].get("status"), 404)

    video_selftest(check)

    if args.browser:
        browser_selftest(check)
        browser_video_selftest(check)
    else:
        print("note: the browser cases need --browser")

    print(f"\n{'PASS' if not failures else 'FAIL'}: {len(failures)} failure(s)")
    return 1 if failures else 0


# What ffprobe printed for four real kinds of file, cut to the fields probe_video reads. Each one
# is a case that a first version of the parser got wrong somewhere.
PROBE_PHONE = {  # a portrait clip from a phone: landscape pixels and a rotation
    "streams": [{"codec_type": "video", "codec_name": "hevc", "pix_fmt": "yuv420p10le",
                 "width": 1920, "height": 1080, "avg_frame_rate": "30000/1001",
                 "r_frame_rate": "90000/1", "side_data_list": [{"rotation": -90}]},
                {"codec_type": "audio", "codec_name": "aac"}],
    "format": {"format_name": "mov,mp4,m4a,3gp,3g2,mj2", "duration": "12.345"}}
PROBE_RECORDER = {  # a MediaRecorder WebM: a timebase for a rate, and no duration
    "streams": [{"codec_type": "video", "codec_name": "vp9", "pix_fmt": "yuv420p",
                 "width": 640, "height": 360, "avg_frame_rate": "0/0",
                 "r_frame_rate": "1000/1"},
                {"codec_type": "audio", "codec_name": "opus"}],
    "format": {"format_name": "matroska,webm"}}
PROBE_COVER = {  # cover art first, then the picture, PCM sound and a timecode track
    "streams": [{"codec_type": "video", "codec_name": "mjpeg", "width": 600, "height": 600,
                 "disposition": {"attached_pic": 1}},
                {"codec_type": "video", "codec_name": "h264", "pix_fmt": "yuv420p",
                 "width": 1080, "height": 1920, "avg_frame_rate": "25/1"},
                {"codec_type": "audio", "codec_name": "pcm_s16le"},
                {"codec_type": "data", "codec_name": "tmcd"}],
    "format": {"format_name": "mov,mp4,m4a,3gp,3g2,mj2", "duration": "4.0"}}
PROBE_ANAMORPHIC = {  # stored 1440 wide, shown 1920 wide
    "streams": [{"codec_type": "video", "codec_name": "h264", "pix_fmt": "yuv420p",
                 "width": 1440, "height": 1080, "sample_aspect_ratio": "4:3",
                 "avg_frame_rate": "25/1"}],
    "format": {"duration": "3.0"}}


def video_selftest(check) -> None:
    """The video path without a browser: ranges, the codec decision, the probe, staging with a
    stub ffmpeg, one real conversion when ffmpeg is installed, the batch and the server."""
    # ---- ranges, the way a browser asks for them -----------------------------------------
    check("a range of two bytes, the way Safari opens a video", byte_range("bytes=0-1", 100), (0, 1))
    check("an open range runs to the end", byte_range("bytes=10-", 100), (10, 99))
    check("a suffix range is the last bytes", byte_range("bytes=-5", 100), (95, 99))
    check("a range past the end of the file is a 416",
          byte_range("bytes=100-", 100), "unsatisfiable")
    check("an empty suffix is a 416", byte_range("bytes=-0", 100), "unsatisfiable")
    check("any range of an empty file is a 416", byte_range("bytes=0-", 0), "unsatisfiable")
    check("an end past the file is cut to the last byte", byte_range("bytes=5-500", 100), (5, 99))
    check("several ranges get the whole file", byte_range("bytes=0-1,5-6", 100), None)
    check("a header that is not a byte range gets the whole file",
          byte_range("items=0-1", 100), None)

    # ---- numbers ffprobe and the page hand over ------------------------------------------
    check("an NTSC rate is read as 29.97", _rate("30000/1001"), 29.97)
    check("a timebase is not a frame rate", _rate("1000/1"), None)
    check("0/0 and N/A are no rate", [_rate("0/0"), _rate("N/A")], [None, None])
    check("a timecode under a minute", timecode(12.4), "0:12.40")
    check("a timecode over an hour", timecode(3725.019), "1:02:05.02")
    check("a timecode rounds half up, as the page does", timecode(0.125), "0:00.13")

    # ---- copy, remux or convert -----------------------------------------------------------
    def plan(vcodec, acodec="aac", pix="yuv420p", suffix=".mp4", duration=5.0):
        return video_plan({"vcodec": vcodec, "acodec": acodec, "pix_fmt": pix,
                           "duration": duration}, suffix)
    check("H.264 in MP4 is copied", plan("h264")["action"], "copy")
    check("H.264 in a QuickTime file is remuxed, not re-encoded",
          [plan("h264", suffix=".mov")[k] for k in ("action", "ext")], ["remux", ".mp4"])
    check("HEVC is converted", plan("hevc")["action"], "convert")
    check("10-bit H.264 is converted", plan("h264", pix="yuv420p10le")["video"], "encode")
    check("AV1 and ProRes are converted",
          [plan("av1")["action"], plan("prores", suffix=".mov")["action"]], ["convert", "convert"])
    pcm = plan("h264", acodec="pcm_s16le", suffix=".mov")
    check("PCM sound keeps the picture and re-encodes only the sound",
          [pcm["action"], pcm["video"], pcm["audio"]], ["convert", "copy", "encode"])
    check("a silent H.264 file is copied", plan("h264", acodec=None)["action"], "copy")
    check("VP9 in WebM is copied", plan("vp9", acodec="opus", suffix=".webm")["action"], "copy")
    check("a WebM without a duration is rewritten so it can be seeked",
          [plan("vp9", acodec="opus", suffix=".webm", duration=None)[k] for k in ("action", "ext")],
          ["remux", ".webm"])
    check("without ffprobe the file is copied", video_plan(None, ".mov")["action"], "copy")
    conv = ffmpeg_command("ffmpeg", plan("hevc"), Path("in.mov"), Path("out.mp4"))
    check("a conversion makes 8-bit 4:2:0 H.264 with even sides and the index in front",
          all(x in conv for x in ("libx264", "yuv420p", "scale=trunc(iw/2)*2:trunc(ih/2)*2",
                                  "+faststart")), True)
    check("a conversion takes the first picture and sound and leaves data tracks out",
          all(x in conv for x in ("0:V:0", "0:a:0?", "-dn", "-sn")), True)
    rmx = ffmpeg_command("ffmpeg", plan("vp9", "opus", suffix=".webm", duration=None),
                         Path("in.webm"), Path("out.webm"))
    check("a remux copies both streams", rmx.count("copy"), 2)
    check("a WebM gets no MP4 flags", "-movflags" in rmx, False)

    # ---- probe_video on what ffprobe really prints ----------------------------------------
    orig_which = shutil.which
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        probe_json, ffmpeg_log, ffmpeg_mode = tmp / "probe.json", tmp / "ffmpeg.log", tmp / "mode"
        stub_probe = tmp / "ffprobe"
        stub_probe.write_text(f"#!{sys.executable}\nimport sys\n"
                              f"sys.stdout.write(open({str(probe_json)!r}).read())\n")
        stub_ffmpeg = tmp / "ffmpeg"
        stub_ffmpeg.write_text(f"""#!{sys.executable}
import json, sys
from pathlib import Path
with open({str(ffmpeg_log)!r}, "a") as log:
    log.write(json.dumps(sys.argv[1:]) + "\\n")
if Path({str(ffmpeg_mode)!r}).read_text().strip() == "fail":
    sys.stderr.write("Unknown encoder 'libx264'\\n")
    sys.exit(1)
Path(sys.argv[-1]).write_bytes(b"converted")
""")
        for stub in (stub_probe, stub_ffmpeg):
            stub.chmod(0o755)
        ffmpeg_log.write_text("")
        ffmpeg_mode.write_text("ok")
        stubs = {"ffprobe": str(stub_probe), "ffmpeg": str(stub_ffmpeg)}

        def probe_of(case):
            probe_json.write_text(json.dumps(case))
            shutil.which = lambda cmd: stubs.get(cmd) or orig_which(cmd)
            try:
                return probe_video(tmp / "any.mov")
            finally:
                shutil.which = orig_which

        phone = probe_of(PROBE_PHONE)
        check("a rotated phone clip is portrait", [phone["width"], phone["height"]], [1080, 1920])
        check("the frame rate is the average one, not the timebase guess", phone["fps"], 29.97)
        check("the duration comes from the container", phone["duration"], 12.345)
        rec = probe_of(PROBE_RECORDER)
        check("a MediaRecorder WebM has no frame rate and no duration",
              [rec["fps"], rec["duration"]], [None, None])
        cover = probe_of(PROBE_COVER)
        check("cover art is not the picture", [cover["vcodec"], cover["width"]], ["h264", 1080])
        check("anamorphic pixels are shown at their display width",
              probe_of(PROBE_ANAMORPHIC)["width"], 1920)
        check("a file with no picture is no video",
              probe_of({"streams": [{"codec_type": "audio", "codec_name": "aac"}],
                        "format": {"duration": "3"}})["vcodec"], None)

        # ---- staging with the stubs ---------------------------------------------------------
        sess = tmp / "sess"
        sess.mkdir()
        clip = tmp / "phone clip.mov"
        clip.write_bytes(b"hevc bytes, round one")
        probe_json.write_text(json.dumps(PROBE_PHONE))
        shutil.which = lambda cmd: stubs.get(cmd) or orig_which(cmd)
        err = io.StringIO()
        try:
            with contextlib.redirect_stderr(err):
                first = stage_inputs([clip], sess)[0]
                runs_after_first = len(ffmpeg_log.read_text().splitlines())
                again = stage_inputs([clip], sess)[0]
                runs_after_second = len(ffmpeg_log.read_text().splitlines())
                clip.write_bytes(b"hevc bytes, a new render")
                stage_inputs([clip], sess)
                runs_after_render = len(ffmpeg_log.read_text().splitlines())
        finally:
            shutil.which = orig_which
        check("a video is one item of kind video", first["kind"], "video")
        check("HEVC is converted once", runs_after_first, 1)
        check("the next round on the same bytes converts nothing", runs_after_second, 1)
        check("a new render is converted afresh", runs_after_render, 2)
        check("only the conversion of the current render is kept",
              len(list((sess / "converted").iterdir())), 1)
        check("the converted copy is served as MP4, its address carries the hash",
              re.fullmatch(r"/asset/d1_phone_clip\.mp4\?v=[0-9a-f]{12}", again["url"]) is not None,
              True)
        check("the item says it was converted", again["converted"], "h264")
        check("the item carries the display size and rate",
              [again["width"], again["height"], again["fps"]], [1080, 1920, 29.97])
        check("the conversion is announced", "converting phone clip.mov" in err.getvalue(), True)

        ffmpeg_mode.write_text("fail")
        clip.write_bytes(b"hevc bytes, a render ffmpeg cannot read")
        shutil.which = lambda cmd: stubs.get(cmd) or orig_which(cmd)
        err = io.StringIO()
        try:
            with contextlib.redirect_stderr(err):
                failed = stage_inputs([clip], sess)[0]
        finally:
            shutil.which = orig_which
        check("a failed conversion stages the original", failed["url"].split("?")[0],
              "/asset/d1_phone_clip.mov")
        check("and says why", "could not convert phone clip.mov (Unknown encoder" in err.getvalue(),
              True)
        check("and claims no conversion", failed["converted"], None)

        shutil.which = lambda cmd: None if cmd in ("ffprobe", "ffmpeg") else orig_which(cmd)
        err = io.StringIO()
        try:
            with contextlib.redirect_stderr(err):
                bare = stage_inputs([clip], sess)[0]
        finally:
            shutil.which = orig_which
        check("without ffmpeg the file is staged as it is",
              [bare["url"].split("?")[0], bare["fps"]], ["/asset/d1_phone_clip.mov", None])
        check("and the reviewer's agent is told how to fix it",
              "install ffmpeg" in err.getvalue(), True)

        probe_json.write_text(json.dumps({"streams": [{"codec_type": "audio",
                                                       "codec_name": "aac"}]}))
        song = tmp / "song.mp4"
        song.write_bytes(b"audio only")
        card = tmp / "card.png"
        card.write_bytes(base64.b64decode(PNG_1PX))
        shutil.which = lambda cmd: stubs.get(cmd) or orig_which(cmd)
        err = io.StringIO()
        try:
            with contextlib.redirect_stderr(err):
                mixed = stage_inputs([song, card], sess)
        finally:
            shutil.which = orig_which
        check("a file with no picture is skipped with its reason",
              [[i["name"] for i in mixed], "song.mp4: it has no video stream" in err.getvalue()],
              [["card.png"], True])

        # A render that rewrites its file in place (ffmpeg -y does) must not change the copy under
        # review: the staged bytes are what the receipt certifies and what the page has buffered.
        probe_json.write_text(json.dumps({"streams": [
            {"codec_type": "video", "codec_name": "h264", "pix_fmt": "yuv420p", "width": 1080,
             "height": 1920, "avg_frame_rate": "30/1"}], "format": {"duration": "2"}}))
        short = tmp / "short.mp4"
        short.write_bytes(b"render one")
        shutil.which = lambda cmd: stubs.get(cmd) or orig_which(cmd)
        try:
            with contextlib.redirect_stderr(io.StringIO()):
                staged = stage_inputs([short], sess)[0]
        finally:
            shutil.which = orig_which
        with short.open("r+b") as fh:
            fh.write(b"render two")
        check("a render in place leaves the reviewed copy alone",
              (sess / "assets" / Path(staged["url"].split("?")[0]).name).read_bytes(),
              b"render one")

        big = tmp / "big.bin"
        big.write_bytes(os.urandom(3 << 20))
        check("the chunked hash is the hash", file_sha256(big),
              hashlib.sha256(big.read_bytes()).hexdigest())

    # ---- one real conversion, when ffmpeg is here -----------------------------------------
    if shutil.which("ffmpeg") and shutil.which("ffprobe"):
        with tempfile.TemporaryDirectory() as tmp:
            tmp = Path(tmp)
            src = tmp / "old.mov"
            made = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-f",
                                   "lavfi", "-i", "testsrc2=s=180x320:r=10:d=1", "-c:v", "mpeg4",
                                   str(src)], capture_output=True, timeout=60)
            if made.returncode == 0:
                sess = tmp / "sess"
                sess.mkdir()
                with contextlib.redirect_stderr(io.StringIO()):
                    item = stage_inputs([src], sess)[0]
                played = probe_video(Path(item["played"])) or {}
                check("a real MPEG-4 QuickTime file comes out as H.264 that browsers play",
                      [played.get("vcodec"), played.get("pix_fmt"), item["fps"], item["duration"]],
                      ["h264", "yuv420p", 10.0, 1.0])
            else:
                print("skip: ffmpeg could not make the conversion fixture")
    else:
        print("skip: the real conversion case needs ffmpeg and ffprobe")

    # ---- the batch -------------------------------------------------------------------------
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        sess = tmp / "sess"
        sess.mkdir()
        (sess / "items.json").write_text(json.dumps([
            {"kind": "video", "id": "d1", "asset": "d1_short", "name": "short.mp4",
             "source": str(tmp / "short.mp4"), "duration": 8.0, "fps": 30.0,
             "width": 1080, "height": 1920, "converted": "h264",
             "played": str(sess / "assets" / "d1_short.mp4")}]))
        png = "data:image/png;base64," + PNG_1PX
        jpeg = "data:image/jpeg;base64," + base64.b64encode(b"\xff\xd8\xff\xe0 tiny").decode()
        batch = write_outputs(sess, {"pages": [{
            "kind": "video", "item": "d1", "name": "short.mp4",
            "frames": [{"key": "3.217", "image": jpeg}, {"key": "4.883", "image": jpeg},
                       {"key": "0.017", "image": "data:image/svg+xml;base64,PHN2Zy8+"}],
            "comments": [
                {"id": "m_1", "number": 1, "tool": "rect", "note": " subtitle too low ",
                 "t": 3.2166666, "frame": "3.217", "crop": png,
                 "box": {"x": 0.2, "y": 0.6, "w": 0.5, "h": 0.15}},
                {"id": "m_2", "number": 2, "tool": "note", "note": "music too loud",
                 "t": 3.2166666, "frame": "3.217", "crop": png},
                {"id": "m_3", "number": 3, "tool": "span", "note": "drags",
                 "t": 4.8833, "t_end": 3.2166666, "frame": "4.883", "frame_end": "3.217"},
                {"id": "m_4", "number": 4, "tool": "laser", "note": "odd tool", "t": 0.0166,
                 "frame": "0.017", "box": {"x": 0.1, "y": 0.1, "w": 0.1, "h": 0.1}},
                {"id": "m_5", "number": 5, "tool": "note", "note": "drawn on a longer cut",
                 "t": 9.5, "frame": "9.500"}]}]})
        page = batch["pages"][0]
        marks = {m["number"]: m for m in page["marks"]}
        check("a video page is its own kind", page["kind"], "video")
        check("the timecode is worked out from t", [marks[1]["timecode"], marks[1]["t"]],
              ["0:03.22", 3.217])
        check("the frame number is the frame on screen", marks[1]["frame_number"], 96)
        check("two notes on one frame share one picture",
              [marks[1]["frame"] == marks[2]["frame"], len(list((sess / "frames").iterdir()))],
              [True, 2])
        check("a frame is a JPEG named by its moment", Path(marks[1]["frame"]).name,
              "d1_short_at_00003217ms.jpg")
        check("a span runs forward even when drawn backward",
              [marks[3]["t"], marks[3]["t_end"], marks[3]["timecode_end"]], [3.217, 4.883, "0:04.88"])
        check("a span has a frame at each end",
              [Path(marks[3]["frame"]).name, Path(marks[3]["frame_end"]).name],
              ["d1_short_at_00003217ms.jpg", "d1_short_at_00004883ms.jpg"])
        check("a shape has a crop, a note has none",
              [Path(marks[1]["crop"]).name, "crop" in marks[2]], ["d1_short_mark_01.png", False])
        check("a tool the page cannot make is carried as a plain note",
              [marks[4]["tool"], "box" in marks[4]], ["note", False])
        check("an image that is not PNG or JPEG is never written", marks[4]["frame"], None)
        check("a moment past the end of this version is flagged, not moved",
              [marks[5]["t"], marks[5].get("past_end")], [9.5, True])
        check("the note is trimmed", marks[1]["note"], "subtitle too low")
        check("the page says which copy t is on", page.get("played"),
              str(sess / "assets" / "d1_short.mp4"))
        md = (sess / "marks.md").read_text()
        check("marks.md gives the moment and the span",
              "1. [0:03.22] (rect) subtitle too low" in md
              and "3. [0:03.22 to 0:04.88] (span) drags" in md, True)
        check("the receipt counts every video note",
              json.loads((sess / "receipt.json").read_text())["items"], 5)

    # ---- the server --------------------------------------------------------------------------
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        sess = tmp / "sess"
        sess.mkdir()
        clip = tmp / "clip.mp4"
        payload = os.urandom(1 << 16)
        clip.write_bytes(payload)
        pdf = tmp / "statement.pdf"
        make_fixture_pdf(pdf, FIXTURE_PAGES)
        shutil.which = lambda cmd: None if cmd in ("ffprobe", "ffmpeg") else orig_which(cmd)
        try:
            with contextlib.redirect_stderr(io.StringIO()):
                items = stage_inputs([clip, pdf], sess)
        finally:
            shutil.which = orig_which
        with serving(sess, items) as base:
            url = base + items[0]["url"].lstrip("/")
            _, headers = fetch(base)
            check("the policy lets the page play its own video",
                  "media-src 'self'" in headers.get("Content-Security-Policy", ""), True)
            body, h = fetch_bytes(url, {"Range": "bytes=0-1"})
            check("Safari's first request gets two bytes and a 206",
                  [h["status"], body, h.get("Content-Range"), h.get("Accept-Ranges")],
                  [206, payload[:2], f"bytes 0-1/{len(payload)}", "bytes"])
            check("a video is served as video", h.get("Content-Type"), "video/mp4")
            body, h = fetch_bytes(url, {"Range": "bytes=65000-"})
            check("a seek gets the rest of the file", [h["status"], body], [206, payload[65000:]])
            body, h = fetch_bytes(url, {"Range": "bytes=-100"})
            check("a suffix range gets the last bytes", body, payload[-100:])
            body, h = fetch_bytes(url, {"Range": "bytes=70000-"})
            check("a range past the end is a 416 that names the size",
                  [h["status"], h.get("Content-Range")], [416, f"bytes */{len(payload)}"])
            body, h = fetch_bytes(url)
            check("without a range the whole file comes with a 200 and says ranges work",
                  [h["status"], len(body), h.get("Accept-Ranges")], [200, len(payload), "bytes"])
            body, h = fetch_bytes(url, method="HEAD")
            check("HEAD gives the size and no body",
                  [h["status"], h.get("Content-Length"), body], [200, str(len(payload)), b""])
            _, h = fetch_bytes(base + items[1]["url"].lstrip("/"), {"Range": "bytes=0-1"})
            check("a PDF is still sent whole, so PDF.js loads it as before",
                  [h["status"], h.get("Accept-Ranges")], [200, None])

        # A browser holds a video download open and stops reading. On a server that answered
        # one request at a time, that held back the draft save and Send.
        big = sess / "assets" / Path(items[0]["url"].split("?")[0]).name
        big.write_bytes(b"\0" * (32 << 20))
        with serving(sess, items) as base:
            stalled = socket.socket()
            stalled.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 4096)
            stalled.connect(("127.0.0.1", urlsplit(base).port))
            stalled.sendall(f"GET /asset/{big.name} HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n".encode())
            time.sleep(0.3)
            t0 = time.time()
            try:
                _, h = fetch_bytes(base + "draft", {"Content-Type": "application/json"}, "POST",
                                   b'{"overall": "still saving"}')
                answered = h["status"]
            except OSError as e:
                answered = f"no answer ({e})"
            check("a stalled video download does not hold back a draft save",
                  [answered, time.time() - t0 < 2], [200, True])
            stalled.close()
            check("the draft is written whole",
                  json.loads((sess / "draft.json").read_text()).get("overall"), "still saving")


@contextlib.contextmanager
def serving(sess: Path, items: list[dict], test_js: str = ""):
    """The real server, in a thread, for the length of a test."""
    box: list = []
    t = threading.Thread(target=serve, args=(sess, items, 0, test_js, box.append), daemon=True)
    t.start()
    for _ in range(200):
        if box:
            break
        time.sleep(0.02)
    if not box:
        raise RuntimeError("the test server did not start")
    try:
        yield f"http://127.0.0.1:{box[0].server_address[1]}/"
    finally:
        box[0].shutdown()


def fetch(url: str) -> tuple[str, dict]:
    body, headers = fetch_bytes(url)
    return body.decode("utf-8", "replace"), headers


def fetch_bytes(url: str, headers: dict | None = None, method: str = "GET",
                data: bytes | None = None) -> tuple[bytes, dict]:
    req = urllib.request.Request(url, headers={"Host": "127.0.0.1", **(headers or {})},
                                 method=method, data=data)
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            return r.read(), {**dict(r.headers), "status": r.status}
    except urllib.error.HTTPError as e:
        return e.read(), {**dict(e.headers), "status": e.code}


# Injected ONLY by the browser selftest, through serve(test_js=...). The shipped page never sees
# it, and the hook it calls does nothing unless this defines window.__TEST__ first.
TEST_JS = r"""
window.__TEST__ = async (api) => {
  const out = [];
  const say = (name, got, want) => out.push([name, got, want]);
  const until = async (fn, ms) => { const t0 = Date.now();
    while (Date.now() - t0 < (ms || 20000)) { try { if (fn()) return true; } catch (e) {}
      await new Promise(r => setTimeout(r, 60)); } return false; };
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const mode = new URLSearchParams(location.search).get("mode") || "wide";
  const nav = document.getElementById("nav"), stage = document.getElementById("stage");
  // A jump scrolls smoothly, so a measurement taken too early reads the middle of the animation
  // and blames whatever ran last. Wait until the stage stops moving.
  const settle = async () => { let last = NaN;
    for (let i = 0; i < 80; i++) { await sleep(70);
      if (stage.scrollTop === last) return; last = stage.scrollTop; } };
  const inkOf = cv => { if (!cv.width) return 0;
    const d = cv.getContext("2d").getImageData(0, 0, cv.width, cv.height).data;
    let n = 0; for (let i = 0; i < d.length; i += 4) if (d[i] < 200 && d[i + 3] > 0) n++;
    return n; };
  try {
    say("the viewport meta tag is there",
        !!document.querySelector('meta[name="viewport"][content*="width=device-width"]'), true);
    const pdfPages = () => [...api.SURFACES.values()].filter(s => s.page);
    await until(() => pdfPages().length === 3);
    say("every page of the PDF is a surface", pdfPages().length, 3);
    const first = pdfPages()[0];
    await until(() => inkOf(first.sheet) > 200);
    say("the first page is drawn, not blank", inkOf(first.sheet) > 200, true);
    say("the page canvas carries the screen's own pixels",
        first.sheet.width, Math.floor(first.box.clientWidth * devicePixelRatio));
    await until(() => api.textLayers.size >= 3 && first.layer.textContent.length > 20);
    say("the text of the page can be read back",
        first.layer.textContent.includes("Interest 1.234,56"), true);

    // A selection inside one page keeps the spaces between the words.
    const spans = [...first.layer.querySelectorAll("span")].filter(s => s.textContent.trim());
    const range = document.createRange();
    range.setStart(spans[1].firstChild, 0);
    range.setEnd(spans[1].firstChild, spans[1].textContent.length);
    const sel = getSelection(); sel.removeAllRanges(); sel.addRange(range);
    say("a selection comes back with its spaces", /\S \S/.test(sel.toString()), true);
    const anchored = api.anchorFor(first.layer, range);
    say("the anchor of a PDF selection carries the quote",
        anchored.quote === range.toString() && anchored.quote.length > 3, true);
    sel.removeAllRanges();

    // The same anchor function on a draft block: the SECOND "placeholder", not the first.
    const blk = [...document.querySelectorAll("[data-blk]")]
      .find(b => (b.textContent.match(/placeholder/g) || []).length === 2);
    const node = blk.firstChild, text = node.textContent;
    const at = text.indexOf("placeholder", text.indexOf("placeholder") + 1);
    const r2 = document.createRange();
    r2.setStart(node, at); r2.setEnd(node, at + "placeholder".length);
    const a2 = api.anchorFor(blk, r2);
    say("a repeated phrase anchors to the occurrence that was selected",
        a2.at === at && a2.anchor.prefix.endsWith("then says "), true);

    // A selection may run over several paragraphs. An editable block is its own editing host and
    // the browser clamps a selection to it, so a block is plain text until the caret is in it.
    say("a draft block is not an editing host until it is clicked", blk.isContentEditable, false);
    const doc = blk.closest(".doc[data-item]"), blks = [...doc.querySelectorAll("[data-blk]")];
    const more = blks.find(b => b.textContent === "More text.");
    const key = b => b.getAttribute("data-blk");

    // The press and release handlers, driven with pointer events. A script cannot make a real drag
    // here, so these pin the handlers' own logic: who is editable after which gesture.
    const press = (el, type, extra) => { const r = el.getBoundingClientRect();
      el.dispatchEvent(new PointerEvent(type, { bubbles: true, button: 0, pointerType: "mouse",
        clientX: r.left + 4, clientY: r.top + 4, ...extra })); };
    sel.collapse(blk.firstChild, 1);
    press(blk, "pointerdown"); press(blk, "pointerup");
    blk.dispatchEvent(new KeyboardEvent("keydown", { key: "a", bubbles: true }));
    say("a key pressed straight after a click finds its block editable", blk.isContentEditable,
        true);
    sel.collapse(blk.firstChild, 3);
    press(blk, "pointerdown"); press(blk, "pointerup"); await sleep(60);
    say("a click makes its block editable", blk.isContentEditable, true);
    say("and puts the caret there", document.activeElement === blk, true);
    press(more, "pointerdown");
    say("a press elsewhere drops it back to plain text at once", blk.isContentEditable, false);
    sel.collapse(more.firstChild, 2); press(more, "pointerup"); await sleep(60);
    say("and the block released in is the only editable one",
        blks.filter(b => b.isContentEditable).map(key), [key(more)]);
    press(blk, "pointerdown", { pointerType: "touch" });
    say("a touch press strips nothing, so a scroll keeps the keyboard", more.isContentEditable, true);
    press(blk, "pointercancel", { pointerType: "touch" });
    sel.setBaseAndExtent(blk.firstChild, 12, blk.firstChild, 2);
    press(blk, "pointerdown"); press(blk, "pointerup"); await sleep(60);
    say("a backward selection keeps its direction",
        [sel.anchorOffset, sel.focusOffset, blk.isContentEditable], [12, 2, true]);

    // Shift+Arrow at the edge of an editable block carries on into the next one.
    sel.collapse(blk.firstChild, blk.firstChild.length);
    blk.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowDown", shiftKey: true, bubbles: true }));
    await sleep(60);
    const touched = () => { const r = sel.getRangeAt(0);
      return blks.filter(b => r.intersectsNode(b) && b.textContent.trim()).map(key); };
    say("Shift+ArrowDown at a block's end extends into the next block",
        touched().slice(0, 2), [key(blk), key(blks[blks.indexOf(blk) + 1])]);
    say("and the block it left is plain text while the selection spans two",
        blk.isContentEditable, false);
    sel.collapse(blk.firstChild, 4); await sleep(60);
    say("a caret back inside that block makes it editable again", blk.isContentEditable, true);
    sel.removeAllRanges(); blk.blur();

    const r3 = document.createRange();
    r3.setStart(blk.firstChild, 2); r3.setEnd(more.firstChild, 4);
    sel.removeAllRanges(); sel.addRange(r3);
    await sleep(150);
    const selbtn = document.getElementById("selbtn");
    say("a selection over three blocks offers Comment", getComputedStyle(selbtn).display, "block");
    document.dispatchEvent(new KeyboardEvent("keydown", { key: "µ", code: "KeyM", ctrlKey: true,
                                                          altKey: true, bubbles: true }));
    say("Ctrl+Alt+M comments on it", api.comments.length, 1);
    const spanned = api.comments.at(-1);
    say("its comment lists every block it touches", spanned.blocks,
        blks.slice(blks.indexOf(blk), blks.indexOf(more) + 1).map(key));
    say("its quote has one line per block", spanned.quote.split("\n").length, 3);
    say("its parts keep each block's own text", spanned.parts.map(p => p.quote).join("\n"),
        spanned.quote);
    say("its prefix comes from the first block", spanned.anchor.prefix, "A ");
    say("its suffix comes from the last block", spanned.anchor.suffix, " text.");

    // A selection that leaves the draft for a PDF page has no single place to sit.
    const r4 = document.createRange();
    r4.setStart(spans[1].firstChild, 0); r4.setEnd(more.firstChild, 4);
    sel.removeAllRanges(); sel.addRange(r4);
    await sleep(150);
    say("a selection from a PDF page into a draft offers no Comment",
        getComputedStyle(selbtn).display, "none");
    sel.removeAllRanges();

    // Shapes on a draft, each by its own geometry, and the words under it as the draft shows them.
    const ds = api.SURFACES.get(doc.dataset.item + "#marks");
    say("a draft is a surface that takes marks", !!ds && ds.marksCanvas.width > 0, true);
    const bb = () => ds.box.getBoundingClientRect();
    const textRect = el => { const r = document.createRange(); r.selectNodeContents(el);
      return r.getBoundingClientRect(); };
    const frac = (x, y) => ({ x: (x - bb().left) / bb().width, y: (y - bb().top) / bb().height });
    const shape = (tool, el, pad) => { const q = textRect(el), a = frac(q.left - pad, q.top - pad),
      z = frac(q.right + pad, q.bottom + pad);
      return { tool, x0: a.x, y0: a.y, x1: z.x, y1: z.y, path: [] }; };
    const h2 = doc.querySelector("h2"), hq = textRect(h2);
    const circle = shape("ellipse", h2, 14);
    api.pinToBlock(ds, circle);
    Object.assign(circle, api.textUnder(ds, circle));
    say("a circle on a draft quotes the words inside it", circle.quote, "Second heading");
    say("and names the block they are in", circle.blocks, [key(h2)]);
    const tip = frac(hq.left + 10, hq.top + hq.height / 2);
    say("an arrow quotes the word at its head",
        api.textUnder(ds, { tool: "arrow", x0: tip.x - 0.1, y0: tip.y - 0.05, x1: tip.x, y1: tip.y,
                            path: [] }).quote, "Second");
    const line = [...Array(20)].map((_, i) => frac(hq.left + (hq.width * i) / 19, hq.bottom + 3));
    say("a freehand underline quotes the words above it",
        api.textUnder(ds, { tool: "free", x0: 0, y0: 0, x1: 0, y1: 0, path: line }).quote,
        "Second heading");
    // Both points 40 px clear of the text: only the segment between them crosses the words.
    const sparse = [frac(hq.left - 40, hq.bottom + 3), frac(hq.right + 40, hq.bottom + 3)];
    say("a fast underline with two points still quotes the words between them",
        api.textUnder(ds, { tool: "free", x0: 0, y0: 0, x1: 0, y1: 0, path: sparse }).quote,
        "Second heading");
    const mixed = blks.find(b => b.querySelector("strong"));
    const er = mixed.querySelector("strong").nextSibling, erR = document.createRange();
    erR.setStart(er, 0); erR.setEnd(er, 2);
    const erQ = erR.getBoundingClientRect(), erTip = frac(erQ.left + erQ.width / 2,
                                                          erQ.top + erQ.height / 2);
    const beta = [...doc.querySelectorAll("li")].find(li => li.textContent === "beta"),
          bq = textRect(beta), bTip = frac(bq.left + bq.width / 2, bq.top + bq.height / 2);
    say("an arrow at one list item quotes that item only, not its neighbours glued on",
        api.textUnder(ds, { tool: "arrow", x0: bTip.x - 0.1, y0: bTip.y - 0.05, x1: bTip.x,
                            y1: bTip.y, path: [] }).quote, "beta");
    const keep = more.innerHTML;
    more.innerHTML = "x<div></div>y<div>in</div>tail";
    const arrowAt = node => { const r = document.createRange(); r.selectNodeContents(node);
      const q = r.getBoundingClientRect(), t = frac(q.left + q.width / 2, q.top + q.height / 2);
      return api.textUnder(ds, { tool: "arrow", x0: t.x - 0.1, y0: t.y - 0.05, x1: t.x, y1: t.y,
                                 path: [] }).quote; };
    say("text after a nested block is its own word", arrowAt(more.lastChild), "tail");
    say("an empty nested block still splits the words around it",
        arrowAt(more.childNodes[2]), "y");
    more.innerHTML = keep;
    say("an arrow at the end of a word split by bold markup quotes the whole word",
        api.textUnder(ds, { tool: "arrow", x0: erTip.x - 0.1, y0: erTip.y - 0.05, x1: erTip.x,
                            y1: erTip.y, path: [] }).quote, "bolder");
    // From the first marked word to the last, so the closing full stop is not part of it.
    say("a box over inline markup quotes the text as shown, with no invented spaces",
        api.textUnder(ds, shape("rect", mixed, 4)).quote, "Plain bolder, em, done");
    const gap = frac(bb().right - 6, bb().bottom - 6);
    const empty = { tool: "rect", x0: gap.x - 0.001, y0: gap.y - 0.001, x1: gap.x, y1: gap.y,
                    path: [] };
    api.pinToBlock(ds, empty);
    const none = api.textUnder(ds, empty);
    say("a mark over no words still names a block and its box",
        [none.quote, none.blocks.length, !!none.box], ["", 1, true]);

    // An edit above a mark moves the mark with its words, so the quote does not change.
    const para = blks.find(b => b.tagName === "P"), was = para.innerHTML;
    para.innerHTML = was + "<br>" + "more words ".repeat(60);
    say("a mark stays on its words after the draft above it grows",
        api.textUnder(ds, circle).quote, "Second heading");
    para.innerHTML = was;

    // What Send posts: the shape and the multi-block comment, with the fields SKILL.md documents.
    api.marks.push({ ...circle, id: 970, item: ds.key, note: "rename it" });
    const batch = await api.buildBatch();
    const tp = batch.pages.find(p => p.kind === "text");
    const sent = tp && tp.comments.find(c => c.id === "m_970");
    say("Send carries a shape on a draft with its words, block and box",
        sent && [sent.tool, sent.quote, sent.blocks, !!sent.box],
        ["ellipse", "Second heading", [key(h2)], true]);
    say("Send carries the multi-block comment's blocks",
        tp && tp.comments.find(c => c.id === "c_" + spanned.id)?.blocks, spanned.blocks);
    say("no media page is made for a draft", batch.pages.filter(p => p.kind === "media").length, 0);
    api.marks.length = 0; api.comments.length = 0;

    // Marks on a PDF page, and the crop that comes out of them.
    api.marks.push({ id: 900, item: first.key, tool: "rect", note: "look here",
                     x0: 0.10, y0: 0.05, x1: 0.60, y1: 0.12, path: [] });
    const ex = await api.exportSurface(first);
    const img = new Image();
