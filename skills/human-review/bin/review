# The video session: d1 is the red-then-blue clip, d2 a draft, d3 a file the browser cannot play.
# The draft saved before the page opened holds a span and a box on d1.
TEST_VIDEO_JS = r"""
window.__TEST__ = async (api) => {
  const out = [];
  const say = (name, got, want) => out.push([name, got, want]);
  const until = async (fn, ms) => { const t0 = Date.now();
    while (Date.now() - t0 < (ms || 20000)) { try { if (fn()) return true; } catch (e) {}
      await new Promise(r => setTimeout(r, 60)); } return false; };
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const mode = new URLSearchParams(location.search).get("mode") || "wide";
  try {
    const s = api.SURFACES.get("d1"), broken = api.SURFACES.get("d3"), v = s.video;
    await until(() => v.readyState >= 2 && v.duration > 0);
    say("the video loads and knows its length", Math.round(v.duration * 10) / 10, 2);
    say("the notes on a video come back from the saved draft",
        api.marks.filter(m => m.item === "d1").map(m => m.tool).sort(), ["rect", "span"]);
    await until(() => s.markers.querySelectorAll(".vmk").length === 2);
    say("and sit on the timeline", s.markers.querySelectorAll(".vmk").length, 2);
    say("the card of a restored span names both moments",
        [...document.querySelectorAll("#feed .card .where")]
          .some(e => e.textContent.includes("0:00.25 to 0:00.75")), true);

    const r = s.box.getBoundingClientRect();
    say("the picture keeps the shape of the video", Math.abs(r.width / r.height - 180 / 320) < 0.02, true);
    say("a Short fits the height of the window", r.height <= innerHeight - 100 && r.height > 150, true);

    say("the player can seek, so the server answers byte ranges", await api.seekAndWait(s, 1.55), true);
    say("and lands where it was sent", Math.abs(v.currentTime - 1.55) < 0.01, true);

    // The pen on a playing video.
    api.setTool("ellipse");
    v.currentTime = 0.3;
    await new Promise(res => v.addEventListener("seeked", res, { once: true }));
    await v.play().catch(() => {});
    await sleep(150);
    const cv = s.marksCanvas, cr = cv.getBoundingClientRect();
    const pen = (type, fx, fy) => cv.dispatchEvent(new PointerEvent(type, {
      pointerId: 1, bubbles: true, isPrimary: true, pointerType: "mouse", button: 0,
      buttons: type === "pointerup" ? 0 : 1,
      clientX: cr.left + fx * cr.width, clientY: cr.top + fy * cr.height }));
